<html>
    <style type="text/css">
        body{
            background:#ededed;
        }
        
        .container{
            margin:10px auto;
            width:600px;
        }
        
        /*-- Email CSS --*/
        
        .mexemeailtheme{
            background-color:#fff;
            font-family:Arial;
            overflow:hidden;
            width:100%;
        }
        
        .mexemeailhead{
            background-color:#328081;
            padding:3px 5px 5px 5px;
            overflow:hidden;
            width:100%;
        }
        
        .mexemeaillogo{
            padding-left:35px;
            overflow:hidden;
            width:100%;
        }
        
        .mexemeaillogo p{
            font-family:Arial;
            font-weight:400;
            font-size:22px;
            color:#fff;
        }
        
        .mexemeaillogo p > sup{
            font-size:15px;
        }
        
        .mexemeailphoto{
            overflow:hidden;
            width:100%;
        }
        
        .mexemeailphoto img{
            max-width:100%;
        }
        
        .mexemeailcontent{
            background-color:#fff;
            padding:10px 30px;
            overflow:hidden;
            color:#5e5e5e;
            width:90%;
        }
        
        .mexemeailcontent p{
            line-height:26px;
            font-size:18px;
            color:#5e5e5e;
        }
        
        .mexemeailbut{
            background-color:#cf614d;
            text-transform:uppercase;
            text-decoration:none;
            padding:15px 35px;
            border-radius:30px;
            width:max-content;
            margin:10px 0px;
            font-weight:600;
            font-size:18px;
            display:block;
            color:#fff;
        }
        
        .mexemeailbut:hover,
        .mexemeailbut:focus{
            opacity:0.9;
        }
        
        .mexemeailsocial{
            padding:15px 35px 35px 35px;
            background-color:#ebf3f3;
            overflow:hidden;
            width:100%;
        }
        
        .mexemeailsocial h3{
            color:#5e5e5e;
        }
        
        .mexemico{
            background-size:100%!important;
            margin-right:10px;
            overflow:hidden;
            display:block;
            float:left;
        }
        
        .mexemico:hover,
        .mexemico:focus{
            opacity:0.8;
        }
        
        /*.mexemailfaceboock{
            background:url(https://www.mexinsurance.com/wp-content/uploads/emailfaceboock.png) no-repeat;
        }
        
        .mexemailinstagram{
            background:url(https://www.mexinsurance.com/wp-content/uploads/emailinstagram.png) no-repeat;
        }
        
        .mexemailtweeter{
            background:url(https://www.mexinsurance.com/wp-content/uploads/emailtweeter.png) no-repeat;
        }*/
        
        .mexemeailfooter{
            background-color:#328081;
            padding:25px 35px;
            overflow:hidden;
            width:100%;
        }
        
        .mexemeailfooter p{
            line-height:26px;
            font-size:16px;
            color:#bcd5d5;
        }
        
        .mexemeailfooter p > a{
            text-decoration:none;
            color:#ffffff;
        }
        
        .mexemeailfooter p > a:hover,
        .mexemeailfooter p > a:focus{
            opacity:0.9;
        }
        
        .mexemeailfooter a{
            text-decoration:none;
            color:#ffffff;
        }
        
        .mexemeailfooter a:hover,
        .mexemeailfooter a:focus{
            opacity:0.9;
        }
    </style>
            <body>
                <div style="background-color:#fff;font-family:Arial;overflow:hidden;width:100%;">

 <div style="display:flex; background-color:#fff; padding:8px 0; ">
