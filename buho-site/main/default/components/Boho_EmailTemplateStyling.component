<apex:component access="global">
    <apex:attribute name="policyType" description="This is the value for the component." type="String" /> 
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
            <style type="text/css">
                body {
                    margin: 0;
                    padding: 0;
                    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
                    background-color: #F5F5F5;
                    -webkit-font-smoothing: antialiased;
                    -moz-osx-font-smoothing: grayscale;
                }
                table {
                    border-collapse: collapse;
                    border-spacing: 0;
                }
                img {
                    border: 0;
                    display: block;
                    outline: none;
                    text-decoration: none;
                }
                .email-container {
                    max-width: 600px;
                    margin: 0 auto;
                    background-color: #ffffff;
                }
                @media only screen and (max-width: 600px) {
                    .email-content {
                        padding: 30px 20px !important;
                    }
                    .email-header {
                        padding: 30px 20px !important;
                    }
                    .header-title {
                        font-size: 22px !important;
                    }
                    .greeting {
                        font-size: 18px !important;
                    }
                    .message-text {
                        font-size: 14px !important;
                    }
                }
            </style>
        </head>
        <body style="margin: 0; padding: 0; background-color: #F5F5F5;">
            <!-- Main Table Wrapper -->
            <table role="presentation" style="width: 100%; background-color: #F5F5F5;" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="padding: 20px 0;">
                        <!-- Email Container -->
                        <table role="presentation" class="email-container" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);" cellpadding="0" cellspacing="0">
                            
                            <!-- Header Section -->
                            <tr>
                                <td class="email-header" style="background: linear-gradient(135deg, #13203D 0%, #13203D 100%); padding: 40px 30px; text-align: center;">
                                    <div>
                                        <img src="https://mexinsurance--partialcpy.sandbox.my.site.com/Buho/webruntime/org-asset/e0b7252c3b/resource/081VD000000lA5b/images/Owl_logo_blue_bg.png" alt="BÚHO Insurance" style="width: 200px; height: auto; margin: 0 auto;" />
                                    </div>
                                    <h1 class="header-title" style="color: #ffffff; font-size: 28px; font-weight: 700; margin: 0; line-height: 1.3; font-family: 'Poppins', Arial, sans-serif; margin-top: -16px;">
                                        <apex:outputText rendered="{!policyType == 'southbound'}">You're Covered in Mexico!</apex:outputText>
                                        <apex:outputText rendered="{!policyType == 'northbound'}">You're Covered in the US &amp; Canada!</apex:outputText>
                                        <apex:outputText rendered="{!policyType == 'driverLicense'}">You're Covered in Mexico!</apex:outputText>
                                        <apex:outputText rendered="{!policyType == 'watercraft'}">Your Watercraft is Covered!</apex:outputText>
                                    </h1>
                                </td>
                            </tr>
                            
                            <!-- Content Section -->
                            <tr>
                                <td class="email-content" style="padding: 40px 30px; background-color: #ffffff;">
                                    
                                    <!-- Greeting -->
                                    <h2 class="greeting" style="color: #1F2937; font-size: 20px; font-weight: 600; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                        Congratulations!
                                    </h2>
                                    
                                    <!-- Southbound Message -->
                                    <apex:outputText rendered="{!policyType == 'southbound'}">
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Your policy is attached to this email. We recommend you print a copy and keep it in the glove box. Having the paperwork in your glove box allows for the retrieval of important information in case you are unable to provide it electronically. You may also need to provide a paper copy for a vehicle permit (if necessary).
                                        </p>
                                        
                                        <!-- Success Notice -->
                                        <div style="background-color: #FEF2F8; border-left: 4px solid #E53C7B; padding: 20px; margin: 30px 0; border-radius: 8px;">
                                            <p style="color: #1F2937; font-size: 14px; line-height: 1.6; margin: 0; font-family: 'Poppins', Arial, sans-serif;">
                                                <strong style="color: #E53C7B;">🎉 You're All Set!</strong> Your BÚHO insurance policy is now active. Drive safely and enjoy your journey to Mexico!
                                            </p>
                                        </div>
                                        
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Thank you for choosing BÚHO Insurance!
                                        </p>
                                    </apex:outputText>
                                    
                                    <!-- Northbound Message -->
                                    <apex:outputText rendered="{!policyType == 'northbound'}">
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Your policy is attached to this email. We recommend you print a copy and keep it in the glove box. Having the paperwork in your glove box allows for the retrieval of important information in case you are unable to provide it electronically.
                                        </p>
                                        
                                        <!-- Success Notice -->
                                        <div style="background-color: #FEF2F8; border-left: 4px solid #E53C7B; padding: 20px; margin: 30px 0; border-radius: 8px;">
                                            <p style="color: #1F2937; font-size: 14px; line-height: 1.6; margin: 0; font-family: 'Poppins', Arial, sans-serif;">
                                                <strong style="color: #E53C7B;">🎉 You're All Set!</strong> Your BÚHO insurance policy for the United States and Canada is now active. Travel safely!
                                            </p>
                                        </div>
                                        
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Thank you for choosing BÚHO Insurance!
                                        </p>
                                    </apex:outputText>
                                    
                                    <!-- Driver License Message -->
                                    <apex:outputText rendered="{!policyType == 'driverLicense'}">
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Your policy is attached to this email. We recommend you print a copy and keep it in the glove box of any vehicle that you drive. Having the paperwork in your glove box allows for the retrieval of important information in case you are unable to provide it electronically.
                                        </p>
                                        
                                        <!-- Success Notice -->
                                        <div style="background-color: #FEF2F8; border-left: 4px solid #E53C7B; padding: 20px; margin: 30px 0; border-radius: 8px;">
                                            <p style="color: #1F2937; font-size: 14px; line-height: 1.6; margin: 0; font-family: 'Poppins', Arial, sans-serif;">
                                                <strong style="color: #E53C7B;">🎉 You're All Set!</strong> Your BÚHO driver's license insurance policy is now active. Drive safely in Mexico!
                                            </p>
                                        </div>
                                        
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Thank you for choosing BÚHO Insurance!
                                        </p>
                                    </apex:outputText>
                                    
                                    <!-- Watercraft Message -->
                                    <apex:outputText rendered="{!policyType == 'watercraft'}">
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Your policy is attached to this email. We recommend you print a copy and keep it with your vessel documentation. Having the paperwork readily available allows for the retrieval of important information in case you are unable to provide it electronically. You will also need to provide a paper copy to the dockmaster.
                                        </p>
                                        
                                        <!-- Success Notice -->
                                        <div style="background-color: #FEF2F8; border-left: 4px solid #E53C7B; padding: 20px; margin: 30px 0; border-radius: 8px;">
                                            <p style="color: #1F2937; font-size: 14px; line-height: 1.6; margin: 0; font-family: 'Poppins', Arial, sans-serif;">
                                                <strong style="color: #E53C7B;">🎉 You're All Set!</strong> Your BÚHO watercraft insurance policy is now active. Safe sailing in Mexico!
                                            </p>
                                        </div>
                                        
                                        <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0; font-family: 'Poppins', Arial, sans-serif;">
                                            Thank you for choosing BÚHO Insurance!
                                        </p>
                                    </apex:outputText>
                                    
                                    <!-- Support Message -->
                                    <p class="message-text" style="color: #6B7280; font-size: 15px; line-height: 1.6; margin: 30px 0 10px 0; font-family: 'Poppins', Arial, sans-serif;">
                                        Need help? Our support team is here for you.
                                    </p>
                                    
                                    <!-- Support Button -->
                                    <div style="text-align: center; margin: 20px 0;">
                                        <a href="mailto:support@gobuho.com" style="display: inline-block; padding: 14px 32px; background-color: #E53C7B; color: #ffffff; text-decoration: none; font-size: 15px; font-weight: 600; border-radius: 8px; font-family: 'Poppins', Arial, sans-serif;">
                                            Contact Support
                                        </a>
                                    </div>
                                    
                                    <!-- Signature -->
                                    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #E5E7EB;">
                                        <p style="color: #6B7280; font-size: 14px; line-height: 1.6; margin: 0; font-family: 'Poppins', Arial, sans-serif;">
                                            <strong style="color: #1F2937;">Charles Lundy</strong><br/>
                                            Founder and CEO<br/>
                                            BÚHO Insurance Brokerage<br/>
                                            License 0E02163
                                        </p>
                                    </div>
                                    
                                </td>
                            </tr>
                            
                            <!-- Footer Section -->
                            <tr>
                                <td class="email-footer" style="background-color: #13203D; padding: 30px; text-align: center;">
                                    <p style="color: rgba(255, 255, 255, 0.8); font-size: 13px; line-height: 1.6; margin: 0 0 15px 0; font-family: 'Poppins', Arial, sans-serif;">
                                        BÚHO Insurance Brokerage<br/>
                                        Smart protection for your Mexican adventures
                                    </p>
                                    
                                    <div style="margin: 20px 0;">
                                        <a href="#" style="color: #89DBEF; text-decoration: none; font-size: 13px; margin: 0 10px; font-weight: 500; font-family: 'Poppins', Arial, sans-serif;">Privacy Policy</a>
                                        <span style="color: rgba(255, 255, 255, 0.4);">|</span>
                                        <a href="#" style="color: #89DBEF; text-decoration: none; font-size: 13px; margin: 0 10px; font-weight: 500; font-family: 'Poppins', Arial, sans-serif;">Terms of Service</a>
                                        <span style="color: rgba(255, 255, 255, 0.4);">|</span>
                                        <a href="#" style="color: #89DBEF; text-decoration: none; font-size: 13px; margin: 0 10px; font-weight: 500; font-family: 'Poppins', Arial, sans-serif;">Contact Us</a>
                                    </div>
                                    
                                    <p style="color:rgba(255,255,255,0.8);font-size:13px;line-height:1.6;margin:15px 0;font-family:'Poppins',Arial,sans-serif">
                                        <img data-emoji="📧" class="an1" alt="📧" aria-label="📧" draggable="false" src="https://fonts.gstatic.com/s/e/notoemoji/16.0/1f4e7/72.png" loading="lazy" style="display:inline-block;vertical-align:middle;width:16px;height:16px;margin-right:5px;"/> 
                                        <a href="mailto:support@gobuho.com" target="_blank">support@gobuho.com</a> 
                                        | <img data-emoji="📞" class="an1" alt="📞" aria-label="📞" draggable="false" src="https://fonts.gstatic.com/s/e/notoemoji/16.0/1f4de/72.png" loading="lazy" style="display:inline-block;vertical-align:middle;width:16px;height:16px;margin-right:5px;margin-left:5px;"/>
                                        <a href="tel:1-800-BUHO-INS" target="_blank">1800006870</a>
                                    </p>
                                </td>
                            </tr>
                            
                        </table>
                    </td>
                </tr>
            </table>
        </body>
    </html>
</apex:component>