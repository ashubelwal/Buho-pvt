                                <th colspan="4" width="100%" style="width: 50%;">Deductibles </th>
                                <th colspan="2" width="50%" style="width: 50%; text-align: right; padding:0px;">
                                    <apex:repeat value="{!coverageMap}" var="listValue">
                                      
                                        <apex:outputPanel rendered="{! AND(listValue.UnderWriter__c == 'Qualitas', showQualitasDeductible)}">
                                            <img src="{!$Resource.icon_checkmark_blue}" />
                                        </apex:outputPanel>  
                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', !showQualitasDeductible)}">
                                            N/A   
                                        </apex:outputPanel>   
                                        
                                    </apex:repeat>
                                    
                                </th>
                            </tr>
                            
                            <tr>
                                <td colspan="2" width="50%" style="width: 50%;">
                                    <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability',  True)}">Collision Deductible
                                    </apex:outputPanel>
                                    </td>
                                <td colspan="2" width="50%" style="width: 50%; text-align: right; padding:4px;">
                                    <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">
                                <apex:outputPanel rendered="{!AND((ratetableReacord.qualitasQuote.collision_deductible == '0'), quoteDetail.Vehicle_Type__c == 'RV')}">
                                    N/A
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!OR((ratetableReacord.qualitasQuote.collision_deductible != '0'), quoteDetail.Vehicle_Type__c != 'RV')}">
                                    ${!ratetableReacord.qualitasQuote.collision_deductible} USD
                                </apex:outputPanel>
                            </apex:outputPanel>
                            </td>
                            </tr>
                            <tr>
                                <td colspan="2" width="50%" style="width: 50%;">
                                    <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">Total Theft Deductible
                                </apex:outputPanel>
                                </td>
                                <td colspan="2" width="50%" style="width: 50%; text-align: right; padding:4px;">
                                    <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">
                                    <apex:outputPanel rendered="{!AND((ratetableReacord.qualitasQuote.theft_Total == '0'), quoteDetail.Vehicle_Type__c == 'RV')}">
                                        N/A
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!OR((ratetableReacord.qualitasQuote.theft_Total != '0'), quoteDetail.Vehicle_Type__c != 'RV')}">
                                        ${!ratetableReacord.qualitasQuote.theft_Total} USD
                                    </apex:outputPanel>
                                </apex:outputPanel>
                                </td>
                            </tr>
                        
                            <tr>
                                <td colspan="3" width="75%" style="width: 100%;">Uninsured/Underinsured Motorist Deductible Wavier</td>
                                <td colspan="1" width="25%" style="width: 25%; text-align: right; padding:4px;">
                                    
                                    <apex:repeat value="{!coverageMap}" var="listValue">
                                        
                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', listValue.Uninsured_Motorist_Deductible_Waiver__c == 'Yes')}">
                                            <img src="{!$Resource.icon_checkmark_blue}" />
                                        </apex:outputPanel>  
                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', listValue.Uninsured_Motorist_Deductible_Waiver__c != 'Yes')}">
                                            <img src="{!$Resource.icon_cross}" />
                                        </apex:outputPanel>   
                                    </apex:repeat>
                                </td>
                            </tr>
                            
                            <tr>
                                <td colspan="4" width="100%" style="width: 100%;">      <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">Labor Rates</apex:outputPanel></td>
