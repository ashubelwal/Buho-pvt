<apex:page applyBodyTag="false" renderAs="pdf" title="Quote PDF" showHeader="false" controller="Mex_ShowSelectedQuotePdf">
    
    <head >
        
        <style> 
           
           body {
            background-color: #bacffc; /* Light gray background color */
            }
            
            @page{
            size: 8.5in 10.5in;
            margin: 0px;
            }
            
            .textAlign{
            text-align: center !important;
            //border:2px solid #000;
            }
            .datepicker{
            border: 1px solid #000;
            background-color: #fff !important;
            padding: 4px;
            }
            
            .borderClass{
            border-radius:4px !important;
            border: 1px solid #999 !important;
            }
            table tr {
                border-bottom: 1px solid #a6a6a6;
            }
        </style>
    </head>
    <body>
        <div style="margin: 0px; padding: 0px; ">
             <table >
            <tr>
             <td width="33%" style="width: 33%; " class="quoteBox">
                    <apex:outputPanel style="padding-bottom:0px; margin:0px;" rendered="{!AND(ratetableReacord.Qualitas == true, ratetableReacord.qualitasQuote.showQualitas == true)}">
                        
                        <table width="100%" style="width: 100%; height: 100%; background-color: #bacffc;; padding-left :4px; padding-right: 0px;">
                            <tr>
                                <td colspan="4" width="100%" style="width: 100%;">
                                    <img src="{!$Resource.QualitasLogoPdf}" width="30%" />
                                </td>
                                
                            </tr>
                            <tr>
                                <td colspan="4" width="100%" style="width: 100%; text-align: center; font-size:28px; font-weight:600;" class="textAlign">
                                    <apex:outputText value="${0, number, ###,##0.00 USD}">
                                        <apex:param value="{!ratetableReacord.qualitasQuote.rateValue}" />
                                    </apex:outputText>
                                    
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4" width="100%" style="width: 100%; text-align: center; color: #B3261E; font-size:20px; font-weight:600;" class="textAlign">
                                    Vehicle : {!quoteDetail.Vehicle_Type__c}
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" width="50%" style="width: 50%; background-color: #fff !important; padding: 4px;" class="borderClass">
                                    <apex:outputText value="{0,date,dd-MMM, yyyy}" >
                                        <apex:param value="{!quoteDetail.Start_Date_for_Coverage__c}" /> 
                                    </apex:outputText>
                                </td>
                                <td colspan="2" width="50%" class="datepicker borderClass"
                                    style="width: 50%; background-color:  !important; padding: 4px;" >
                                    <apex:outputText value="{0,date,dd-MMM, yyyy}">
                                        <apex:param value="{!quoteDetail.End_Date_for_Coverage__c}" /> 
                                    </apex:outputText>
                                </td>
                            </tr>
                            <!--<tr>
                                <td colspan="2" width="50%" style="width: 50%; background-color:  !important; padding: 4px;" class="datepicker borderClass">
                                    {!startTime}
                                </td>
                                <td colspan="2" width="50%" style="width: 50%; background-color:  !important; padding: 4px;" class="datepicker borderClass">
                                    {!endTime}
                                </td>
                            </tr> -->
                            <tr>
                                <td colspan="2" width="50%" style="width: 50%; ">
                                    Days
                                </td>
                                <td colspan="2" width="50%" style="width: 50%; background-color:  !important; text-align: center;" class="textAlign datepicker borderClass">
                                    {!ratetableReacord.qualitasQuote.days}
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" width="50%" style="width: 50%;">
                                    Combine Liablity
                                </td>
                                <td colspan="2" width="50%" style="width: 50%; background-color:  !important; text-align: center;" class="textAlign datepicker borderClass">
                                    {!ratetableReacord.qualitasLiability}
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" width="50%" style="width: 50%;">
                                    Medical
                                </td>
                                <td colspan="2" width="50%" style="width: 50%; background-color:  !important; text-align: center;" class="textAlign datepicker borderClass">
                                    {!ratetableReacord.qualitasMedical}
                                </td>
                            </tr>
                            <tr style="margin-bottom:4px;">
                                <td colspan="2" width="50%" style="width: 50%;">
                                    Liablity Only
                                </td>
                                <td colspan="2" width="50%" style="width: 50%; text-align: right; padding:4px;">
                                    <apex:outputPanel rendered="{!quoteDetail.Coverage__c == 'Liability'}">
                                        <img src="{!$Resource.icon_checkmark_blue}" />
                                    </apex:outputPanel>  
                                    <apex:outputPanel rendered="{!quoteDetail.Coverage__c != 'Liability'}">
                                        <img src="{!$Resource.icon_cross}" />
                                    </apex:outputPanel>  
                                </td>
                            </tr>
                            
