                                        </apex:outputPanel>  
                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', listValue.Roadside_Assistance__c != 'Yes')}">
                                            <img src="{!$Resource.icon_cross}" />
                                        </apex:outputPanel>   
                                    </apex:repeat>
                                </td>
                            </tr>
                            <tr>
