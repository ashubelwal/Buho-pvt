                                <td colspan="3" width="75%" style="width: 75%;">      <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">Rental Car</apex:outputPanel></td>
                                <td colspan="1" width="25%" style="width: 25%; text-align: right; padding:4px;">      <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">
                                    <apex:repeat value="{!coverageMap}" var="listValue">
                                        
                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', listValue.Rental_Car__c == 'Yes')}">
                                            <img src="{!$Resource.icon_checkmark_blue}" />
                                        </apex:outputPanel>  
                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', listValue.Rental_Car__c != 'Yes')}">
                                            <img src="{!$Resource.icon_cross}" />
                                        </apex:outputPanel>   
                                    </apex:repeat>
                                </apex:outputPanel>
                                </td>
                            </tr>
                        
