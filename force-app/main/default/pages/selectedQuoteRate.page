                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', listValue.Legal_Defense_and_Bail__c != 'Yes')}">
                                            <img src="{!$Resource.icon_cross}" />
                                        </apex:outputPanel>   
                                    </apex:repeat>
                                </td>
                            </tr>
                           
                            <tr>
                                <td colspan="3" width="75%" style="width: 75%;">      <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">Vandalism</apex:outputPanel></td>
                                <td colspan="1" width="25%" style="width: 25%; text-align: right; padding:4px;">      <apex:outputPanel rendered="{!!AND(quoteDetail.Coverage__c == 'Liability', True)}">
                                    <apex:repeat value="{!coverageMap}" var="listValue">
                                        <apex:outputPanel rendered="{!AND(listValue.Underwriter__c == 'Qualitas', listValue.Vandalism__c == 'Yes')}">
                                            <img src="{!$Resource.icon_checkmark_blue}" />
                                        </apex:outputPanel>
