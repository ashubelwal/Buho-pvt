                                    {!policy.Vehicle_Policy__r.Registered_State__c}
                                </td> 
                                <td class="primaryVehicleLastHeading">
                                    <apex:outputText value="$" rendered="{!NOT(ISNULL(policy.Vehicle_Policy__r.Value__c))}" />
                                    <apex:outputText value="{0,number, ###,##0.00}">
                                        <apex:param value="{!policy.Vehicle_Policy__r.Value__c}" />
                                    </apex:outputText>  
                                    
                                </td>
                            </tr>
                        </table>
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_Lienholder__c}">
