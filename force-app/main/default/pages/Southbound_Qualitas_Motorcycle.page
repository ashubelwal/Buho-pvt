                                        <td style="font-weight: bold;">Lien Holder (Primary Loss Payee):</td>
                                        <td>{!policy.Vehicle_Policy__r.Lienholder_name__c}&nbsp;{!policy.Vehicle_Policy__r.Lienholder_Street__c},&nbsp;{!policy.Vehicle_Policy__r.Lienholder_City__c}&nbsp;{!policy.Vehicle_Policy__r.Lienholder_State__c}&nbsp;{!policy.Vehicle_Policy__r.Lienholder_Postal_Code__c}</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td>Customer Service 800-428-4034, Fax: 800-229-5076</td>
                                    </tr>
                                </table>
                            </div>
                        </apex:outputText>
                    </div>
                    
                    <!--- towed units table------ -->
                    <apex:outputPanel rendered="{!IF(towedUnitsList.size > 0, 'true', 'false')}">
                        <apex:repeat value="{!towedUnitsList}" var="towedUnit">
                            <br/>
                            <div style="border:1px solid #b7b1b1;">
                                <table class="maintable" rules="none" style="padding 15px;">
                                    <caption style="border-bottom:1px solid #b7b1b1;background-color:#E8E8E8;text-align:left;padding:5px;"><b>{!towedUnit.Towed_Unit_Type__c}</b>
                                    </caption>
                                    <tr>
                                        <th>Year</th> 
                                        <th>Make</th>
                                        <th>Model</th> 
                                        <th>VIN</th> 
                                        <th>Plate</th>
                                        <th>Value</th>
                                    </tr> 
                                
                                    <tr>
                                        <td >  
                                            {!towedUnit.Year__c}
                                        </td> 
                                        <td style="text-transform:uppercase;">  
                                            {!towedUnit.Make__c}
                                        </td> 
                                        <td style="text-transform:uppercase;">  
                                            {!towedUnit.Model__c}
                                        </td> 
                                        <td style="text-transform:uppercase;">  
                                            {!towedUnit.VIN_Number__c}
                                        </td> 
                                        <td >
                                            {!towedUnit.Plate__c}
                                        </td> 
                                        <td > 
                                            <apex:outputText value="$" rendered="{!NOT(ISNULL(towedUnit.Towed_Unit_Value__c))}" />
                                            <apex:outputText value="{0,number, ###,##0.00}">
                                                <apex:param value="{!towedUnit.Towed_Unit_Value__c}" />
                                            </apex:outputText>
                                            
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </apex:repeat>
                    </apex:outputPanel>
                    <!--- towed units table ends ----- -->
                </div>
            
        </table>
        
    </div>
    <br/>
    <div style="border:2px solid #b7b1b1;">
        <table class="maintable">
            <caption style="border-bottom:1px solid #b7b1b1;background-color:#E8E8E8;text-align:left;padding:5px;"><b>Drivers</b>                
            </caption>
            <tr>
                <th>Name</th>
                <th>DOB</th>
                <th>License</th>
            </tr>
            <apex:repeat value="{!drivers}" var="driver" >
                <tr>
                    <td> {!driver.First_Name__c} &nbsp; {!driver.Last_Name__c} </td>
                    <td>
                        <apex:outputText value="{0,date,MMM dd, yyyy}">
                            <apex:param value="{!driver.Dob__c}"/>
                            </apex:outputText>
                    </td>
                    <td>
                        {!driver.LN_With_Country__c}
                    </td>
                </tr>
            </apex:repeat>
        </table>
    </div>
    <div style="page-break-before:always;"/>
    <br/>
    <div style="border:2px solid #b7b1b1;">
