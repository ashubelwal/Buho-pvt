                                    <apex:param value="{!ROUND(policy.Net_Premium__c, 2)}" />
                                </apex:outputText>
                                
                            </td>
                            <td>
                                <apex:outputText value="$" rendered="{!NOT(ISNULL(policy.Surcharge__c))}" />
                                <apex:outputText value="{0,number, ###,##0.00}">
