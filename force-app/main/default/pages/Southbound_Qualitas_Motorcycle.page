<apex:page applyBodyTag="false" controller="Declaration_Page_Insurance_Controller" renderAs="pdf">
    <head>
        <style>           
            
              #pageNum:before{
            content: "Page " counter(page) " of " counter(pages);
            }
            @page {
            margin-top: 1.2in;
            margin-left: 1.0cm;
            margin-bottom: 0.45in;
            margin-right: 1.0cm;      
            page-break:always; 
            page-break-inside:avoid;
            }
            @page{
                @top-center  {
                content: element(header);
                }
            
                 @bottom-left 
                {
                    content: element(footer);
                }
            
            }
            div.header 
            {
            padding: 10px;
            position: running(header);
            }
            
            div.footer 
            {
                display: block;
                position: running(footer);
            }
            div.d4 {
                border: 1px solid red;
                font-size:small;
            }
            .maintable{ 
            border-collapse:collapse;
            font-size:13px;
            }
            .maintable th,td{
            padding: 5px;
            text-align: left;
            background-color:white;
            font-size:13px;
            width:1000px; 
            }
            .maintable2{
            border-collapse:collapse;
            background-color:#E8E8E8;
            font-size:13px
            }
            .maintable2 td{background-color:white;font-size:13px;width:1000px;text-align: center; }
            .row {
        display: flex; /* equal height of the children */
        position: relative;
        margin:auto;
        }
            .pagenumber:before 
            {
                content: counter(page);
            }
            
            .pagecount:before 
            {
                content: counter(pages);
            }
            .primaryVehicleLastHeading{
               font-size:11px !important;
            }
        </style>
    </head>
    <div class="header">
        
        <div style="margin-top:0px">
            <img src="{!$Resource.Qualitas}" width="70" height="100"/>
        </div>
        
        
        <div style="display:inline; position:absolute; top:20px; left: 20%; font-size: 35px;">
            
            <b> Tourist Motorcycle Insurance Policy</b>
            <br/>        
        </div>
        <br/>
        <div style="display:inline; position:absolute; top:60px; left: 25%; font-size: 20px;">
            MexInsurance Policy# {!policy.Name}<br/>
        </div>
    </div>
     <div class="footer">
        <div style="border: 1px solid black; ">Page <span class="pagenumber"/> of <span class="pagecount"/></div>
    </div>
    
    <div style="border:2px solid #b7b1b1;">
        
        <table class="maintable">
            <caption style="border-bottom:1px solid #b7b1b1;background-color:#E8E8E8;text-align:left;padding:5px;"><b>Insured Name and Information</b></caption>
                
            
            <tr>
                <td ><b>Name</b> &nbsp; &nbsp; &nbsp; 
                    <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        {!policy.Vehicle_Policy__r.Company_Name__c}
                    </apex:outputText>
                    <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Name__c)}">
                            {!policy.Vehicle_Policy__r.Vehicle_Owner_Name__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Name__c)}">
                            <apex:outputText rendered="{!!ISBLANK(driver.First_Name__c)}">
                                {!driver.First_Name__c} &nbsp; {!driver.Last_Name__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(driver.First_Name__c)}">
                                {!policy.Contact__r.Name}
                            </apex:outputText>
                        </apex:outputText>
                    </apex:outputText>
                    <br/>
                    <b>Address</b> &nbsp; 
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                              {!policy.Vehicle_Policy__r.Company_Address__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                            <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Address__c)}">
                                {!policy.Vehicle_Policy__r.Vehicle_Owner_Address__c}, &nbsp;{!policy.Vehicle_Policy__r.Vehicle_Owner_City__c}, &nbsp;{!policy.Vehicle_Policy__r.Vehicle_Owner_Postal_Code__c}, &nbsp;{!policy.Vehicle_Policy__r.Vehicle_Owner_State__c}, &nbsp;{!policy.Vehicle_Policy__r.Vehicle_Owner_Country__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Address__c)}">
                                <apex:outputText rendered="{!!ISBLANK(driver.Address__c)}">
                                    {!driver.Address__c}, &nbsp; {!driver.Address_Line_2__c} &nbsp; {!driver.City__c}, &nbsp; {!driver.Postal_Code__c} &nbsp; {!driver.State_Province__c}, &nbsp; {!driver.Country__c}
                                </apex:outputText>
                                <apex:outputText rendered="{!ISBLANK(driver.Address__c)}">
                                    {!policy.Contact__r.Street__c}, &nbsp; {!policy.Contact__r.City__c}, &nbsp; {!policy.Contact__r.Postal_Code__c} &nbsp;{!policy.Contact__r.State__c}, &nbsp;{!policy.Contact__r.Country__c}
                                </apex:outputText>
                            </apex:outputText>
                        </apex:outputText>
                    
                </td> 
                <td>
                    
                                       
                    <b>License &nbsp; &nbsp;</b>
                        <!--<apex:outputText rendered="{!!ISBLANK(primaryInsuredDriver.license_number__c)}">
                            {!primaryInsuredDriver.LN_With_Country__c}
                        </apex:outputText>-->
                        <apex:outputText >
                            {!driver.LN_With_Country__c}
                        </apex:outputText> &nbsp; ({!driver.License_Country__c}-{!driver.License_state__c})
                    <apex:outputPanel rendered="{!NOT(driver.License_Expire__c == null)}">
                        Expires <apex:outputText value="{0,date, MMM dd, yyyy}">
                                    <apex:param value="{!driver.License_Expire__c}"/>
                                </apex:outputText>
                    </apex:outputPanel>
                    
                </td>
                
            </tr>
        </table>
    </div> 
    <br/>
    <div style="border:2px solid #b7b1b1;">       
        
        <table class="maintable">
            <caption style="border-bottom:1px solid #b7b1b1;background-color:#E8E8E8;text-align:left;padding:5px;"><b>Terms of Insurance</b>
                
            </caption>
            <tr>
                <th style="width:20%">Policy #</th> <td style="width:20%"> {!policy.Name} </td><th style="width:15%">Broker</th><td>Mexico Insurance Services, Inc. California Department of Insurance 0G35864</td>
            </tr>
            <tr>
                <th style="width:20%">Issue Date</th>
                <td colspan="2">
                    <apex:outputText value="{!formattedIssuanceDate}"></apex:outputText> &nbsp;
                    <apex:outputText value="{!formattedIssuanceTime}"></apex:outputText> &nbsp;
                    <!-- <apex:outputText value="{0,time,HH:mm a}">
                        <apex:param value="{!policy.Issued_At__c}"/>
                    </apex:outputText> -->
                </td>
            </tr>
            <tr>
                <th style="width:20%">Coverage Area</th><td colspan="3">
                    <apex:outputPanel rendered="{!policy.Territory_picklist__c == 'Full'}">
                        All of Mexico
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!policy.Territory_picklist__c == 'Limited'}">
                        Baja, Sonora, Chihuahua, Coahuila, Nuevo Leon, Tamaulipas
                    </apex:outputPanel>
                    <apex:outputPanel rendered="{!and( policy.Territory_picklist__c != 'Full', policy.Territory_picklist__c != 'Limited') }">
                        {!policy.Territory_picklist__c}
                    </apex:outputPanel>
                </td>
            
            </tr>
            <tr>
                <th style="width:20%">Effective Dates</th>
                <td colspan="3">
                    <apex:outputText value="{0,date, MMM dd, yyyy}">
                        <apex:param value="{!policy.Start_Date__c}"/>
                    </apex:outputText>
                    &nbsp;{!FormattedStartTime}
                    -
                    
                    <apex:outputText value="{0,date, MMM dd, yyyy}">
                        <apex:param value="{!policy.End_Date__c}"/>
                    </apex:outputText>
                    {!FormattedEndTime}
                </td>
            </tr>
        </table>
        
    </div>
    <p style="text-align: justify; font-size: 12px">
        Qualitas Compania de Seguros S.A. de C.V. a Mexican Insurance Company, provides coverage subject to the terms and conditions of the
        policy. Coverage applies only to the below and solely for the risks covered under the contract provided not to exceed the maximum limit of
        liability specified below. All amounts are expressed in U.S. Dollars.
        Description of insured vehicle, towed units and specifications of covered risks:
    </p>
    <div style="border:2px solid #b7b1b1;">
        <table class="maintable">
