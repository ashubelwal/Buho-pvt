<apex:page controller="Declaration_Page_Insurance_Controller" applyBodyTag="false" renderAs="pdf">
    <head>
        <style>
            @page {
            margin-top: 1.5in;
            margin-bottom: 1.1in;
            @bottom-left 
            { 
            content: element(footer);
            }
            @top-left {
            content: element(header);
            }
            @top-center {
            content: element(header1);
            }
            }
            #pageNum:before{
            content: "Page " counter(page) " of " counter(pages);
            }
            td.td1{
            text-align:center;
            }
            div.footer{
            font-size: 12.5px;
            position: running(footer);
            display:block;}
            div.header {
            position: running(header);
            border: 1px solid red;
            }
            div.header1 {
            position: absolute;
            font-size: normal;
            left: 0;
            top: 60px;
            width: 95%;
            }
            h4.h_1
            {
            color:red;
            text-align:left;
            display:inline;
            }
            div.d3 {
            TEXT-ALIGN: CENTER;
            border: 1px solid red;
            }
            div.d4 {
            border: 1px solid red;
            font-size:small;
            }
            th{
            text-align:center;
            }
            th.th1{
            text-align:center;
            font-weight:normal;
            }
            mark{
            background-color:yellow;
            }
            td.td2{background-color:#A9A9A9;border: 1px solid;}
            .row {
            display: flex; /* equal height of the children */
            position: relative;
            margin:auto;
            }
            
            .col {
            flex: 1; /* additionally, equal width */
            
            padding: 1em;
            border: none;
            }
        </style>
    </head>
    <div class="header">
        <div class="header" style="font-size: large;
                                   position: static;
                                   height: 22px;
                                   width: 47%;
                                   background-color: red;">
            <span style="color:white; font-weight:bold;margin-left: 10px;">Tourist Mexico Insurance&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
        </div>
        <br/>
        <div class="row">
            <div class="col">
                <img src="{!$Resource.Maxfre_Logo}" width="45%"/>
            </div>
            
            <div class="col header1" style="left:50% !important; top: 0 !important;">
                <b><apex:outputText value="ISSUE DATE:" /></b>&nbsp;
                <apex:outputText value="{!formattedIssuanceDate}"></apex:outputText> &nbsp;
                <apex:outputText value="{!formattedIssuanceTime}"></apex:outputText> &nbsp;
                    <!-- <apex:outputText value="{0,time,HH:mm a}">
                        <apex:param value="{!policy.Issued_At__c}"/>
                    </apex:outputText> -->
                    <br/>
                <b><apex:outputText value="POLICY NO:"/></b>&nbsp;{!policy.Name}
            </div>
        </div>
        
    </div>
    <h4 class="h_1">
        IN CASE OF AN ACCIDENT 
    </h4>  
    <div class="d3">
        <apex:outputText value="ALL CLAIMS MUST BE REPORTED IN MEXICO BEFORE RETURNING TO U.S.A." /><BR/>
        <apex:outputText value="CALL IN MEXICO: " /><B><apex:outputText value="55-5950-2108, 01-800-026-6358, 01-800-026-6551" /></B>
        
    </div>
    <br/>
     
    <h4 class="h_1">
        GENERAL INFORMATION 
    </h4>
    <div class="d4">
        <table align="center" style="width: 100%;">
            <tr><th class="th1" colspan="5">DAY-MONTH-YEAR</th>
            </tr>
            <tr>
                <td>VALID FROM THE&nbsp;&nbsp;
                </td>
                <td>
                    <apex:outputText value="{0,date,MMM dd, yyyy}">
                        <apex:param value="{!policy.Start_Date__c}" /> 
                    </apex:outputText>
                </td>
                <td>HRS OF:&nbsp;&nbsp;
                </td>
                <td>
                    {!FormattedStartTime}&nbsp;&nbsp;
                </td>
                <td>TOTAL DAYS&nbsp;&nbsp;</td>
            </tr>
            
            <tr>
                <td>TO THE&nbsp;&nbsp;
                </td>
                <td>
                    <apex:outputText value="{0,date,MMM dd, yyyy}">
                        <apex:param value="{!policy.End_Date__c}" /> 
                    </apex:outputText> &nbsp;&nbsp;
                </td>
                <td>HRS OF:&nbsp;&nbsp;
                </td>
                <td>{!FormattedEndTime}&nbsp;&nbsp;
                </td>
                <td class="td1">{!policy.Term_days__c}&nbsp;&nbsp;</td>
                
            </tr>
            
        </table>
    </div>
    <br/>
    <h4 class="h_1">
        INSURED 
    </h4>
    <div class="d4">
        <table ALIGN="CENTER" style="width: 100%;" >
            <tr>
                <td>INSURED:</td>
                <td>
                    <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        {!policy.Vehicle_Policy__r.Company_Name__c}
                    </apex:outputText>
                    <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Name__c)}">
                            {!policy.Vehicle_Policy__r.Vehicle_Owner_Name__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Name__c)}">
                            <apex:outputText rendered="{!!ISBLANK(driver.First_Name__c)}">
                                {!driver.First_Name__c} &nbsp; {!driver.Last_Name__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(driver.First_Name__c)}">
                                {!policy.Contact__r.Name}
                            </apex:outputText>
                        </apex:outputText>
                    </apex:outputText>
                </td>
                <td>CITIZENSHIP:</td>
                <td></td>
            </tr>
            <tr>
                <td>ADDRESS</td>
                <td><div>
                    <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        {!policy.Vehicle_Policy__r.Company_Address__c}
                    </apex:outputText>
                    <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Address__c)}">
                            {!policy.Vehicle_Policy__r.Vehicle_Owner_Address__c},&nbsp;{!policy.Vehicle_Policy__r.Vehicle_Owner_City__c}, &nbsp;{!policy.Vehicle_Policy__r.Vehicle_Owner_State__c}, &nbsp;{!policy.Vehicle_Policy__r.Vehicle_Owner_Country__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Address__c)}">
                            <apex:outputText rendered="{!!ISBLANK(driver.Address__c)}">
                                {!driver.Address__c}, &nbsp; {!driver.Address_Line_2__c} &nbsp; {!driver.City__c}, &nbsp; {!driver.State_Province__c}, &nbsp; {!driver.Country__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(driver.Address__c)}">
                                {!policy.Contact__r.Street__c}, &nbsp; {!policy.Contact__r.City__c}, &nbsp;{!policy.Contact__r.State__c}, &nbsp;{!policy.Contact__r.Country__c}
                            </apex:outputText>
                        </apex:outputText>
                    </apex:outputText> 
                    </div>
                </td>
                <td>OCCUPATION:</td>
                <td></td>
            </tr>
            <tr>
                <td>USA INSURANCE COMPANY</td>
                <td></td>
                
                <td>TELEPHONE:</td>
                <td>
                    <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        {!policy.Vehicle_Policy__r.Company_Phone__c}
                    </apex:outputText>
                    <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_vehicle_owned_by_a_company_or_rented__c}">
                        <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Phone__c)}">
                            {!policy.Vehicle_Policy__r.Vehicle_Owner_Phone__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Phone__c)}">
                            <apex:outputText rendered="{!!ISBLANK(driver.Phone__c)}">
                                {!driver.Phone__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(driver.Phone__c)}">
                                {!policy.Contact__r.Phone}
                            </apex:outputText>
                        </apex:outputText>
                    </apex:outputText>
                </td>
            </tr>
            <tr><td>LIENHOLDER:</td><td>{!policy.Vehicle_Policy__r.Lienholder_name__c}</td></tr>
        </table>
    </div>
    <br/>
    <h4 class="h_1">
        Drivers 
    </h4>
    <div class="d4">
        <table ALIGN="CENTER" style="width: 100%;" >
            <tr>
                <td><b>Name</b></td>
                <td><b>DOB</b></td>
                <td><b>License</b></td>
            </tr>
            <apex:repeat value="{!drivers}" var="driver" >
                <tr>
                    <td> {!driver.First_Name__c} &nbsp; {!driver.Last_Name__c} </td>
                    <td>
                        <apex:outputText value="{0,date,MMM dd, yyyy}">
                            <apex:param value="{!driver.Dob__c}"/>
                        </apex:outputText>
                    </td>
                    <td>
                        {!driver.LN_With_Country__c}
                    </td>
                </tr>
            </apex:repeat>
        </table>
    </div>
    <br/>
    
    <h4 class="h_1">
        ECONOMIC CONCEPTS 
    </h4>
    <div class="d4">
        <table align="CENTER" style="width: 100%;"  cellspacing="6px" cellpadding="2px">
            <tr>
                <td>METHOD OF PAYMENT: Online &nbsp; {!trans.Id__c}</td>
                <td>STATE TAX: </td>
            </tr>
            <tr>
                <td>CURRENCY: U.S.A. DOLLARS</td>
                <td>TAX: &nbsp;
                    <apex:outputText value="$" rendered="{!NOT(ISNULL(policy.I_V_A_Mex_Tax__c))}" />
                    <apex:outputText value="{0,number, ###,##0.00}">
                        <apex:param value="{!ROUND(policy.I_V_A_Mex_Tax__c, 2)}" />
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <td>NET PREMIUM: &nbsp;
                    <apex:outputText value="$" rendered="{!NOT(ISNULL(policy.Net_Premium__c))}" />
                    <apex:outputText value="{0,number, ###,##0.00}">
                        <apex:param value="{!ROUND(policy.Net_Premium__c, 2)}" />
                    </apex:outputText>
                </td>
                <td>TOTAL: &nbsp;
                    <apex:outputText value="$" rendered="{!NOT(ISNULL(policy.Total_Premium_Amount__c))}" />
                    <apex:outputText value="{0,number, ###,##0.00}">
                        <apex:param value="{!ROUND(policy.Net_Premium__c + policy.Broker_Policy_Fee__c + policy.I_V_A_Mex_Tax__c, 2)}" />
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <td>POLICY FEE: &nbsp;
                    <apex:outputText value="$" rendered="{!NOT(ISNULL(policy.Broker_Policy_Fee__c))}" />
                    <apex:outputText value="{0,number, ###,##0.00}">
                        <apex:param value="{!ROUND(policy.Broker_Policy_Fee__c, 2)}" />
                    </apex:outputText>
                </td>
            </tr>
            
        </table>
    </div><br/>
    <div>
        <p style="font-size:12px;">
            MAPFRE MÉXICO, S.A., HEREINAFTER REFERED TO AS "THE COMPANY", HEREBY INSURES THE INDIVIDUAL OR COMPANY, HEREINAFTER 
            REFERED AS “THE INSURED”, IN ACCORDANCE WITH THE GENERAL AND SPECIAL CONDITIONS OF THIS POLICY.
        </p>
        <p style="font-size:14px; font-weight:normal;">
            IN ACCORDANCE WITH THE PROVISIONS OF ARTICLE 202 OF THE INSURANCE AND SECURITIES INSTITUTIONS ACT, THE CONTRACTUAL 
            DOCUMENTATION AND TECHNICAL NOTE THAT COMPRISE THIS PRODUCT WERE DULY REGISTERED WITH THE NATIONAL INSURANCE AND SECURITIES
            COMMISSION AS OF 14 OF SEPTEMBER 2017, WITH THE NUMBER: CNSF-S0041-0377-2017 / CONDUSEF-002294-02.
        </p>
        <p style="font-size:12px">
            IN TESTIMONY OF WHICH MAPFRE MÉXICO, S.A. SIGN THIS FORM IN MEXICO CITY. THIS POLICY IS NOT PROOF 
            OF PAYMENT; REQUIRE YOUR RECEIPT WHEN PAYING THE PREMIUM.
        </p>
    </div>
    <div class="footer" >
        Av. Revolución #507, Col. San Pedro de los Pinos, Del. Benito Juarez, Ciudad de México,<br/> 
        CP 03800 Tel.: 52-30-70-00 R.F.C. MTE440316E54
        <div style="position: absolute; display:inline; left: 600px; top:0px">
            <img src="{!$Resource.SignOnPolicyPage}" width="70" height="50"/>
        </div>
        <div style="border: 1px solid red; ">
            <span id="pageNum"/>
        </div>
        
    </div>
    <br/>
    <br/>
    <p style="color:red; text-align:left; ">
        <B >
            VEHICLE INFORMATION 
        </B>
    </p>
    <div  class="d4">
        <table align="CENTER" cellspacing="8px" cellpadding="10px" style="width: 100%;">
            <tr>
                <td class="td2">ITEM</td>
                <td class="td2">YEAR</td>
                <td class="td2">MAKE</td>
                <td class="td2">MODEL</td>
                <td class="td2">PLATE</td>
                <td class="td2">VIN</td>
            </tr>
            
            <tr>
                <td style="border: 1px solid">VEHICLE</td>
                <td>{!policy.Vehicle_Policy__r.Year__c}</td>
