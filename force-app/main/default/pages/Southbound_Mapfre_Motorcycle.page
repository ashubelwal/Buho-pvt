                </td>
                <td class="td1">
                    
                </td>
            </tr>
            <tr>
                <td>PARTIAL THEFT</td>
                <td class="td1" colspan="2"></td>
                <td class="td1">
                    <apex:outputText rendered="{!NOT(ISBLANK(cvrgDetail.Partial_Theft__c))}">
                        {!cvrgDetail.Partial_Theft__c}
                    </apex:outputText>
                    <apex:outputText rendered="{!ISBLANK(cvrgDetail.Partial_Theft__c)}">
                        N/A
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <td>PLANE TICKETS</td>
                <td class="td1" colspan="2"></td>
                <td class="td1">
                    <apex:outputText rendered="{!NOT(ISBLANK(cvrgDetail.Plane_Tickets_Home__c))}">
                        {!cvrgDetail.Plane_Tickets_Home__c}
                    </apex:outputText>
                    <apex:outputText rendered="{!ISBLANK(cvrgDetail.Plane_Tickets_Home__c)}">
                        N/A
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <td>RENTAL CAR</td>
                <td class="td1" colspan="2"></td>
                <td class="td1">
                    <apex:outputText rendered="{!NOT(ISBLANK(cvrgDetail.Rental_Car__c))}">
