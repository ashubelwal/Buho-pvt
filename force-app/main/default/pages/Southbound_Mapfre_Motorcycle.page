                <th colspan="2">SUM INSURED</th>
                <th>DEDUCTIBLE</th>
            </tr>
            <tr>
                <td>PHYSICAL DAMAGE</td>
                <td class="td1" colspan="2">
                    <apex:outputText value="$" rendered="{!policy.Package__c != 'Liability'}" />
                    <apex:outputText rendered="{!policy.Package__c != 'Liability'}" value="{0,number, ###,##0.00}">
                        <apex:param value="{!policy.Insured_value__c}"/>
                    </apex:outputText>
                    <apex:outputText rendered="{!policy.Package__c == 'Liability'}">
                        $0
                    </apex:outputText>
                </td>
                <td class="td1">
                    <apex:outputText value="$" rendered="{!AND(NOT(ISNULL(policy.Vehicle_deductible_collision__c)), policy.Vehicle_deductible_collision__c != 'undefined')}"/>
