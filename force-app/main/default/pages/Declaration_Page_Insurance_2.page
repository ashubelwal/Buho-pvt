    <div class="footer">
        <div style="border: 1px solid black; ">
                <span id="pageNum"/>
        </div>
    </div>
    <div class="container">
        <div style="background-color:#E8E8E8; font-weight:bold; font-size:10.5pt; width:100%">Datos del Asegurado y datos generales de la póliza / Insured Information &amp; policy general data</div>
        <div class="floatLeft">
            <table class="t1" cellspacing="0" cellpadding="0">
                <tr>
                    <th>Nombre / Name:</th>
                    <td style="text-transform: capitalize;">
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            {!policy.Vehicle_Policy__r.Company_Name__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Name__c)}">
                                {!policy.Vehicle_Policy__r.Vehicle_Owner_Name__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Name__c)}">
                                <apex:outputText rendered="{!!ISBLANK(driver.First_Name__c)}">
                                    {!driver.First_Name__c} &nbsp; {!driver.Last_Name__c}
                                </apex:outputText>
                                <apex:outputText rendered="{!ISBLANK(driver.First_Name__c)}">
                                    {!policy.Contact__r.Name}
                                </apex:outputText>
                            </apex:outputText>
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <th>Fecha de Nac / DOB:</th>
                    <td>
                        <apex:outputpanel rendered="{!!ISBLANK(driver.Dob__c)}">
                            <apex:outputText value="{0,date,MMM dd, yyyy}">
                                <apex:param value="{!driver.Dob__c}" />
                            </apex:outputText>

                        </apex:outputpanel>
                        <apex:outputpanel rendered="{!ISBLANK(driver.Dob__c)}">
                            <apex:outputText value="{0,date,MMM dd, yyyy}">
                                <apex:param value="{!policy.Contact__r.Date_of_Birth__c}" />
                            </apex:outputText>

                        </apex:outputpanel>
                    </td>
                </tr>
                <tr>
                    <th>Domicilio / Address:</th>
                    <td style="text-transform: capitalize;">
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            {!policy.Vehicle_Policy__r.Company_Address__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Address__c)}">
                                {!policy.Vehicle_Policy__r.Vehicle_Owner_Address__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Address__c)}">
                                <apex:outputText rendered="{!!ISBLANK(driver.Address__c)}">
                                    {!driver.Address__c} &nbsp; {!driver.Address_Line_2__c}
                                </apex:outputText>
                                <apex:outputText rendered="{!ISBLANK(driver.Address__c)}">
                                    {!policy.Contact__r.Street__c}
                                </apex:outputText>
                            </apex:outputText>
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <th>Ciudad / City:</th>
                    <td style="text-transform: capitalize;">
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            {!policy.Vehicle_Policy__r.Company_City__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_City__c)}">
                                {!policy.Vehicle_Policy__r.Vehicle_Owner_City__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_City__c)}">
                                <apex:outputText rendered="{!!ISBLANK(driver.City__c)}">
                                    {!driver.City__c}
                                </apex:outputText>
                                <apex:outputText rendered="{!ISBLANK(driver.City__c)}">
                                    {!policy.Contact__r.City__c}
                                </apex:outputText>
                            </apex:outputText>
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <th>C.P. / Zip Code:</th>
                    <td>
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            {!policy.Vehicle_Policy__r.Company_Zip__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Postal_Code__c)}">
                                {!policy.Vehicle_Policy__r.Vehicle_Owner_Postal_Code__c}
                            </apex:outputText>
                            <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Postal_Code__c)}">
                                <apex:outputText rendered="{!!ISBLANK(driver.Postal_Code__c)}">
                                    {!driver.Postal_Code__c}
                                </apex:outputText>
                                <apex:outputText rendered="{!ISBLANK(driver.Postal_Code__c)}">
                                    {!policy.Contact__r.Postal_Code__c}
                                </apex:outputText>
                            </apex:outputText>
                        </apex:outputText>
                    </td>
                </tr>
                <!--tr>
                    <th>E-mail:</th>
                    <td>
                        <apex:outputText rendered="{!!ISBLANK(primaryInsuredDriver.Email__c)}">
                            {!primaryInsuredDriver.Email__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!ISBLANK(primaryInsuredDriver.Email__c)}">
                            {!policy.Contact__r.Email}
                        </apex:outputText>
					</td>
				</tr-->
                
                <tr style="text-transform: capitalize;">
                    <th style="width:153px;">Drivers License Country:</th>
                    <td>{!driver.License_Country__c}</td>
                </tr>
                <tr>
                    <th>Drivers License State:</th>
                    <td>{!driver.License_state__c}</td>
                </tr>
            </table>
        </div>
        <div class="floatRight">
            <table class="t1" cellspacing="0" cellpadding="0">
                <tr>
                    <th>Teléfono / Phone:</th>
                    <td>
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            {!policy.Vehicle_Policy__r.Company_Phone__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            <apex:outputText rendered="{!!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Phone__c)}">
                                {!policy.Vehicle_Policy__r.Vehicle_Owner_Phone__c}
