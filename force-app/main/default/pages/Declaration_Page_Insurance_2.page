                            <apex:outputText rendered="{!ISBLANK(policy.Vehicle_Policy__r.Vehicle_Owner_Phone__c)}">
                                <apex:outputText rendered="{!!ISBLANK(driver.Phone__c)}">
                                    {!driver.Phone__c}
                                </apex:outputText>
                                <apex:outputText rendered="{!ISBLANK(driver.Phone__c)}">
                                    {!policy.Contact__r.Phone}
                                </apex:outputText>
                            </apex:outputText>
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <th>Estado / State:</th>
                    <td>
                        <apex:outputText rendered="{!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            {!policy.Vehicle_Policy__r.Company_State__c}
                        </apex:outputText>
                        <apex:outputText rendered="{!!policy.Vehicle_Policy__r.Is_the_vehicle_registered_to_a_business__c}">
                            {!policy.Vehicle_Policy__r.Vehicle_Owner_State__c}
                        </apex:outputText>
                    </td>
                </tr>
                <tr>
                    <th>R.F.C. / Tax Payer ID:</th>
                    <td>0000000000000</td>
                </tr>
                <tr>
                    <th>Moneda / Currency:</th>
                    <td>Dólares</td>
                </tr>
                <tr>
                    <th>Forma de pago/Payment installments:</th>
                    <td>Contado</td>
                </tr>
                <tr>
                    <th>Clave del Agente / Agent code:</th>
                    <td>356</td>
                </tr>
                 <tr>
                    <th>Drivers License Number:</th>
                    <td>{!driver.license_number__c}</td>
                </tr>
            </table>
        </div>
    </div>
    <div>
        <div style="background-color:#E8E8E8; font-weight:bold; font-size:10.5pt; width:100%">Conductor Nombrado y Conductores Adicionales / Named Driver and Additional Drivers</div>
        <div>
            <table class="t1" cellspacing="0" cellpadding="0" style="width:100%;">
                <tr>
                    <th style="width:35%;">Name</th>
                    <th style="width:30%;">DOB</th>
                    <th style="width:35%;">License</th>
                </tr>
                <apex:repeat value="{!drivers}" var="driver">
                    <tr>
                        <td style="text-transform: capitalize;"> {!driver.First_Name__c}&nbsp;{!driver.Last_Name__c} </td>
                        <td>
                            <apex:outputText value="{0,date,MMM dd, yyyy}">
                                <apex:param value="{!driver.Dob__c}" />
                            </apex:outputText>
                        </td>
                        <td>
                            {!driver.LN_With_Country__c}
                        </td>
                    </tr>
                </apex:repeat>
            </table>
        </div>
    </div>
    <div>
        <div style="background-color:#E8E8E8; font-weight:bold; font-size:11.25pt; width:100%">Descripción del Vehículo / Vehicle Description</div>
        <div>
            <table class="t1" cellspacing="0" cellpadding="0">
                <tr style="font-size:9pt; width:100%;">
                    <td style="width:33%;">
                        <table>
                            <tr>
                                <th>Año / Year:</th>
                                <td>{!policy.Vehicle_Policy__r.Year__c}</td>
                            </tr>
                            <tr>
                                <th>Serie / VIN:</th>
                                <td>{!policy.Vehicle_Policy__r.Vin__c}</td>
                            </tr>
                        </table>
                    </td>
                    <td style="width:33%;">
                        <table>
                            <tr>
                                <th>Marca / Make:</th>
                                <td style="text-transform: uppercase;">{!policy.Vehicle_Policy__r.Make__c}</td>
                            </tr>
                            <tr>
                                <th>Placas / Plates:</th>
                                <td style="text-transform: uppercase;">{!policy.Vehicle_Policy__r.Registered_Plate__c}</td>
                            </tr>
                        </table>
                    </td>
                    <td style="width:33%;">
                        <table>
                            <tr>
                                <th>Modelo / Model:</th>
                                <td style="text-transform: uppercase;">{!policy.Vehicle_Policy__r.Model__c}</td>
                            </tr>
                            <tr>
                                <th>Uso / Use:</th>
                                <td>{!policy.What_is_the_purpose_of_trip__c}</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div>
        <div style="background-color:#E8E8E8; font-weight:bold; font-size:9pt; width:100%">Towed Unit</div>
        <div>
            <table class="t1" cellspacing="0" cellpadding="0" style="font-size:9pt;">
                <tr>
                    <th style="width: 25%;">Unit Name</th>
                    <th style="width: 35%;">Registration #/License Plate</th>
                    <th style="width: 18%;">Days in Tow</th>
                    <th style="width: 18%;">Value</th>
                    <th style="width: 18%;">VIN</th>
                </tr>
                <apex:outputText rendered="{!towedUnitsList.size = 0}">
                    <tr>
                        <td style="text-transform: uppercase;">NA</td>
                        <td style="text-transform: uppercase;">NA</td>
                        <td>NA</td>
                        <td>
                            NA
                        </td>
                        <td>NA</td>
                    </tr>
                </apex:outputText>
                <apex:repeat value="{!towedUnitsList}" var="towedUnit">
                    <tr>
                        <td style="text-transform: uppercase;">{!towedUnit.Year__c} &nbsp; {!towedUnit.Make__c} &nbsp; {!towedUnit.Model__c}</td>
                        <td style="text-transform: uppercase;">{!towedUnit.Plate__c}</td>
                        <td>{!towedUnit.Days_in_Tow__c}</td>
                        <td>
                            <apex:outputText value="$" rendered="{!NOT(ISNULL(towedUnit.Towed_Unit_Value__c))}" /> 
                            <apex:outputText value="{0,number, ###,##0.00}">
                                <apex:param value="{!towedUnit.Towed_Unit_Value__c}" />
                            </apex:outputText>
                        </td>
                        <td>{!towedUnit.VIN_Number__c}</td>
                    </tr>
                </apex:repeat>
            </table>
        </div>
    </div> 

