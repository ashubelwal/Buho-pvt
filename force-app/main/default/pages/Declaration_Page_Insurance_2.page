<apex:page applyBodyTag="false"  controller="Declaration_Page_Insurance_Controller" renderAs="pdf" >
    <head>
        <style>
            @page {
                @top-left {
                    content: element(header);
                }
            }

            div.header {
                display: block;
                position: running(header);
                width: auto;
            }

            hr.line {
                height: 1px;
                border-width: 0;
                color: #D3D3D3;
                background-color: #D3D3D3;
            }

            table.t1 {
                font-size: 12px;
                width=: 100%;
            }

            table.t2 {
                font-size: 10px;
            }

            .floatLeft {
                width: 53%;
                float: left;
            }

            .floatRight {
                width: 47%;
                float: right;
            }

            .container {
                overflow: hidden;
            }

            ol li {
                margin: 0;
                padding: 0;
            }

            <!--td.td1 {
                border: 1px solid silver;
            }

            -->.maintable {
                border-collapse: collapse;
                background-color: #E8E8E8;
               font-size:9.75pt
            }

            .maintable td {
                background-color: white;
                border: 1px solid silver;
                font-size:9.75pt
                width: 20px
            }
            
          @page {
            font-family:Times New Roman;
      margin-top: 0.9in;       
            margin-bottom: 0.3in;
            margin-left: 0.2in;
            margin-right: 0.2in;
        @bottom-left 
        { 
        content: element(footer);
        }
        @top-left {
        content: element(header);
        }
        @top-center {
        content: element(header1);
        }

        }
        #pageNum:before{
        content: "Page " counter(page) " of " counter(pages);
        }
        td.td1{
        text-align:center;
        }
        div.footer{
        font-size: 12.5px;
        position: running(footer);
        display:block;}
        div.header {
        position: running(header);
            margin-top:30px;
        }
        .Devisions{
        top :-10px !important;
        border: 1px solid black;
        }
        div.header1 {
        position: absolute;
        font-size: normal;
        left: 0;
        top: 60px;
        width: 95%;
        }
         div.header2 {
        position: absolute;
        font-size: normal;
        left: 0;
        width: 95%;
        }
        h4.h_1
        {
        color:black;
        text-align:left;
        display:inline;
        }
        div.d3 {
        TEXT-ALIGN: CENTER;
        border: 1px solid #0CBFD6;
        }
        div.d4 {
        border: 1px solid #0CBFD6;
        font-size:small;
        }
        
        th.th1{
        text-align:center;
        font-weight:normal;
        }
        mark{
        background-color:yellow;
        }
        td.td2{background-color:#A9A9A9;border: 1px solid;}
        .row {
        display: flex; /* equal height of the children */
        position: relative;
        margin:auto;
        }
        
        .col {
        flex: 1; /* additionally, equal width */
        
        padding: 1em;
        border: none;
        }
        
            
            table.t1{
            font-size:14px;
            }
            hr
            {
            border: 0.5px solid #BDBDBD;
            margin:0px;
            }
        </style>
    </head>
     <div class="header">
        <div class="row">
            <div class="col" >
                <img src="{!$Resource.Chubb_logo}" width="25%"/>
            </div>
            <div class="col header2" style="left:55% !important; top: 0 !important; padding: 0 !important; font-size: 10pt;">
                Chubb Seguros México, S.A.
                <br/> Paseo de la Reforma 250 Torre Niza Piso 15 Col. Juárez, Del.<br/>
                Cuauhtémoc Cd. de México, C.P. 06600
                <br/> www.chubb.com/mx
            </div>
        </div>
    </div>
    <div class="Devisions_1" style="width: 100%;">
        <div class="row" style="display: flex">
            <div class="col" style=" padding: 0 !important;">
                <p style="font-weight:600; font-family:Times; font-size: 9.75pt;">
                    PÓLIZA DE SEGURO DE RESPONSABILIDAD CIVIL PARA AUTOS TURISTAS CON PLACAS MEXICANAS EN<br/>
                    E.U.A. Y CANADÁ - AUTO TURISTA NORTHBOUND / USA AND CANADA THIRD PARTY LIABILITY TOURIST AUTO INSURANCE POLICY FOR MEXICAN PLATED VEHICLES - TOURIST AUTO NORTHBOUND
                </p>
            </div>
        </div>
        <div class="row">
            <p style="text-align: justify; font-size: 9.75pt; margin-top:-12px;">
                Chubb Seguros México, S.A. (en lo sucesivo la “Compañía”), asegura a favor de la persona identificada como “Asegurado” los
                bienes y riesgos más adelante detallados, de acuerdo a las Condiciones Generales y Particulares de esta póliza durante
                la vigencia establecida. / Chubb Seguros México, S.A. (Herein after the “Company”), insures in favor of the person
                identified as the “Insured” the goods and risks set forth detailed, accordingly to the General and Particular Conditions
                of this Policy during the term established.
            </p>
        </div>
    </div>
   
    <div style="font-size: 10pt; margin-top:-12px;">
        <table align="center" width="100%" cellspacing="0" cellpadding="0">
            <hr/>
            <tr style="margin-top:-10px;">
                <th style = "font-weight: bold;">No. de Póliza / Policy No.</th>
                <td >{!policy.Chubb_Policy_Number__c}</td>
            </tr>
            <hr/>
            <tr style="margin-top:-10px;">
                <th style = "font-weight: bold;" width="33%">Vigencia de la Póliza / Policy Period : </th>
                <td >
                    <apex:outputText value="{0,date,MMM dd, yyyy}">
                        <apex:param value="{!policy.Start_Date__c}" /> 
                    </apex:outputText> {!FormattedStartTime}&nbsp;to  &nbsp;
                    <apex:outputText value="{0,date,MMM dd, yyyy}">
                        <apex:param value="{!policy.End_Date__c}" /> 
                    </apex:outputText> {!FormattedEndTime} &nbsp;    
                </td>
                <th style = "font-weight: bold;" width="11%">Días / Days : </th>
                <td >{!policy.Term_days__c}</td>
            </tr>
            <hr/>
        </table>        
    </div>
    
