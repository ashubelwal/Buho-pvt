<apex:page applyBodyTag="false" renderAs="pdf" title="Quote PDF" showHeader="false" controller="Mex_ShowSelectedQuotePdf" contentType="application/pdf#AccountReport.pdf">

    <head>
        <style>
            body {
                background-color: #ffffff; /* White background */
                font-family: Arial, sans-serif;
                font-size: 12px;
                color: #000;
            }
            
            @page {
                 @top-center 
                {
                    content: element(header);
                }
                size: A4;
               margin: 160px 30px 30px 30px;
            }
            div.header 
            {
                padding: 10px;
                position: running(header);
                text-align: center;
                margin-bottom: 20px; 
            }
            


            h1, h2, h3 {
                text-align: center;
                margin: 5px 0;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 15px;
            }

            th, td {
                border: 1px solid #ccc;
                padding: 6px;
                text-align: left;
                vertical-align: top;
            }

            th {
                background: #f5f5f5;
                font-weight: bold;
            }

            .no-border td {
                border: none !important;
                padding: 3px;
            }

            .section-title {
                font-size: 14px;
                font-weight: bold;
                margin: 10px 0 5px 0;
                border-bottom: 1px solid #000;
                padding-bottom: 4px;
            }

            .text-center {
                text-align: center;
            }
        </style>
    </head>
    
    <body>
        <!-- Header -->
         <div class = "header">
            <div align="auto">
                <apex:outputPanel rendered="{!IF(CONTAINS(sitePath,'Buho'),true,false)}">
                    <img src="{!$Resource.buhoAssets + '/images/Logo.png'}" style="height:30px; width:auto; float:left;" />
                </apex:outputPanel>
                <apex:outputPanel rendered="{!IF(CONTAINS(sitePath,'Buho'),false,true)}">
                    <img src="{!$Resource.MexInsuranceLogo}" style="height:30px; width:auto; float:left;" />
                </apex:outputPanel>
                
                <apex:outputPanel rendered="{!quoteDetail.Underwriter__c == 'Mapfre'}">
                    <img src="{!$Resource.Maxfre_Logo}" style="height:40px; width:auto;float:right;" />
                </apex:outputPanel>
                <apex:outputPanel rendered="{!quoteDetail.Underwriter__c == 'Chubb'}">
                    <img src="{!$Resource.chubb_png_logo}" style="height:40px; width:auto;float:right;" />
                </apex:outputPanel>
                <apex:outputPanel rendered="{!quoteDetail.Underwriter__c == 'Qualitas'}">
                    <img src="{!$Resource.QualitasLogoPdf}" style="height:40px; width:auto;float:right" />
                </apex:outputPanel>
            </div>
            <div style="clear: both;  padding-top: 20px; padding-right:100px">
                <h1>Insurance Quote</h1>
                <h3>
                    Date: <apex:outputText value="{0,date,dd-MMM-yyyy}">
                        <apex:param value="{!TODAY()}" />
                    </apex:outputText>
                </h3>
            </div>
            

            <!-- Insurer Logo -->
            
        </div>

        <!-- Quote Summary -->
        <div class="section-title">Quote Summary</div>
        <table>
            <tr>
                <th>Name</th>
                <td>{!name}</td>
            </tr>
            <tr>
                <th>Quote Value</th>
                <td>
                    <apex:outputText value="{0, number, $###,##0.00}">
                        <apex:param value="{!quoteDetail.Quote_Value__c}" />
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <th>Vehicle Type</th>
                <td>{!quoteDetail.Vehicle_Type__c}</td>
            </tr>
            <tr>
                <th>Coverage Period</th>
                <td>
                    <apex:outputText value="{0,date,dd-MMM-yyyy}">
                        <apex:param value="{!quoteDetail.Start_Date_for_Coverage__c}" />
                    </apex:outputText>
                    -
                    <apex:outputText value="{0,date,dd-MMM-yyyy}">
                        <apex:param value="{!quoteDetail.End_Date_for_Coverage__c}" />
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <th>Number of Days</th>
                <td>{!quoteDetail.Term_Days__c}</td>
            </tr>
            <tr>
                <th>Combined Liability</th>
                <td>${!quoteDetail.Liability__c}</td>
            </tr>
            <tr>
                <th>Medical Coverage</th>
                 <td>
                <apex:outputPanel rendered="{!quoteDetail.Vehicle_Type__c != 'Motorcycle'}">
                   ${!quoteDetail.Medical__c}
                </apex:outputPanel>
                </td>
               
            </tr>
            <tr>
                <th>Liability Only</th>
                <td>
                    <apex:outputPanel rendered="{!quoteDetail.Coverage__c == 'Liability'}">Yes</apex:outputPanel>
                    <apex:outputPanel rendered="{!quoteDetail.Coverage__c != 'Liability'}">No</apex:outputPanel>
                </td>
            </tr>
        </table>

        <!-- Coverage Details -->
        <div class="section-title">Coverage Details</div>
        <table>
            <tr>
                <th>Coverage</th>
                <!-- <th>Title</th> -->
                <th>Description</th>
            </tr>
            <apex:repeat value="{!coveredBenefits}" var="cov">
                <tr style="page-break-inside:avoid;">
                    <td>{!cov['Coverage']}</td>
                    <!-- <td>{!cov['Title']}</td> -->
                    <td>{!cov['Description']}</td>
                </tr>
            </apex:repeat>
        </table>

        
    </body>
</apex:page>