<aura:component implements="flexipage:availableForAllPageTypes,force:hasRecordId,force:appHostable">
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="consentGiven" type="Boolean" default="false" />
    
    <div class="slds-box slds-theme_default">
        <h2>Double Opt-In Consent Form</h2>
        <p>Please provide your consent to receive SMS messages from us:</p>
        
        <lightning:input type="checkbox" label="I consent to receive SMS messages." 
                         aura:id="consentCheckbox" 
                         checked="{!v.consentGiven}" />
        
        <lightning:button label="Submit" onclick="{!c.submitConsent}" />
    </div>
</aura:component>