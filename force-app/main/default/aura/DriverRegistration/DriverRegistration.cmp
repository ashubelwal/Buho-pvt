<aura:component controller="QuickQuotationCtrl"
                implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
                access="global">
    <aura:attribute name="driverObject" type="Driver__c" default="{ 'sobjectType': 'Driver__c'}" access="public"/>
    <aura:attribute name="isOwner" type="boolean" default="true"/>

    <aura:attribute name="policyType" type="String" access="public"/>
	<aura:attribute name="driverForEdit" type="Driver__c" access="public"/>
    <aura:attribute name="driverTypeOptions" type="list" />
    <aura:attribute name="stateOptions" type="list"/>
    <aura:attribute name="stateOptionsLicense" type="list"/>
    <aura:attribute name="countryOption" type="List"/>
    <aura:attribute name="Primary_insured" type="boolean" default="false"/>
	<aura:attribute name="iscloneConditionPass" type="boolean" default="false" />
    
    <aura:attribute name="showStatePick" type="boolean" default="false"/>
    <aura:attribute name="showStatePickLicense" type="boolean" default="false"/>
    <aura:attribute name="showCountryInput" type="Boolean" default="false"/>
    <aura:attribute name="showCountryLicenseInput" type="Boolean" default="false"/>
    <aura:attribute name="disableCountryInput" type="Boolean" default="false"/>
    <aura:attribute name="disableCountryLicenseInput" type="Boolean" default="false"/>
    <aura:attribute name="policyCountry" type="String" access="public"/>
    <aura:attribute name="policyCountryInput" type="String" access="public"/>
    <aura:attribute name="policyCountryLicense" type="String" access="public"/>
    <aura:attribute name="policyCountryLicenseInput" type="String" access="public"/>
    <aura:attribute name="isCommunityUser" type="Boolean" access="public"/>
    <aura:attribute name="drivers" type="List" access="public"/>

    <aura:method name="validateFields" action="{!c.validateInputFields}" access="PUBLIC" /> 

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <lightning:layout multipleRows="true">
        <lightning:layoutItem size="12">
            <aura:if isTrue="{!v.policyType == 'Watercraft'}">
                <h3 class="slds-m-bottom_small red">Captain/Owner</h3>
                <aura:set attribute="else">
                    <h3 class="slds-m-bottom_small red">Driver</h3>
                </aura:set>
            </aura:if>
        </lightning:layoutItem>

        <div class="slds-size_12-of-12">
            <div class="grid -spacing-md">
                <div class="grid_1-2 grid_1-sm">
                    <lightning:input required="true" aura:id="validateField" name="First_Name__c" type="text" label="" value="{!v.driverObject.First_Name__c}"
                                     placeholder="First Name" variant="label-hidden" onchange="{!c.updateDriverField}"/>
                </div>
                <div class="grid_1-2 grid_1-sm">
                    <lightning:input required="true" aura:id="validateField" name="Last_Name__c" type="text" label="" value="{!v.driverObject.Last_Name__c}"
                                     placeholder="Last Name" variant="label-hidden" onchange="{!c.updateDriverField}"/>
                </div>
                
                <aura:if isTrue="{!and( empty( v.drivers ))}">
                 
                    <aura:if isTrue="{!not(v.isCommunityUser)}">
                        <div class="grid_1-2 grid_1-sm">
                            <lightning:input aura:id="validateField" required="true" name="Email__c" 
                                             type="email"  label="" value="{!v.driverObject.Email__c}"
                                             placeholder="Email Address" variant="label-hidden"
                                             onchange="{!c.updateDriverField}"/>
                        </div>
                    </aura:if>
                    
                    <div class="grid_1-2 grid_1-sm">
                        <lightning:input aura:id="validateField" required="true" name="Phone__c" type="tel"
                                        label="" value="{!v.driverObject.Phone__c}"
                                        pattern="^\(\d{3}\)\s\d{3}-\d{4}$"
                                        messageWhenPatternMismatch="Not a valid phone number"
                                        placeholder="Phone" variant="label-hidden" onchange="{!c.updateDriverField}"/>
                    </div>
                </aura:if>
                
                <div class="grid_1-2 grid_1-sm">
                    <aura:if isTrue="{!v.policyType == 'Watercraft'}">
                        <!--lightning:input required="true" aura:id="validateField" name="Dob__c" type="date" label="" value="{!v.driverObject.Dob__c}"
                                         placeholder="Captain's Date of Birth" variant="label-hidden"
                                         onchange="{!c.updateDriverField}" /-->

                        <c:customDate label="Captain's Date of Birth" custDate="{!v.driverObject.Dob__c}" 
                                required="true" aura:id="customValidateField"  /> 

                        <aura:set attribute="else">
                            <!--lightning:input required="true" aura:id="validateField" name="Dob__c" type="date" label="" value="{!v.driverObject.Dob__c}"
                                             placeholder="Date of Birth" variant="label-hidden"
                                             onchange="{!c.updateDriverField}" /-->
                            <c:customDate label="Date of Birth" custDate="{!v.driverObject.Dob__c}" 
                                required="true" aura:id="customValidateField"  /> 
                        </aura:set>
                    </aura:if>

                </div>
                <div class="grid_1-2 grid_1-sm">
                    <lightning:combobox required="true" aura:id="validateField" name="Driver_Type__c" placeholder="Driver Type" variant="label-hidden"
                                        value="{!v.driverObject.Driver_Type__c}" options="{! v.driverTypeOptions }"
                                        onchange="{!c.updateDriverField}"/>
                </div>
                <div class="grid_1-2 grid_1-sm">
                    <lightning:input type="checkbox" name="Primary_insured__c" label="Primary insured" checked="{!v.Primary_insured}"  />
                </div>
            </div>
        </div>
        <aura:if isTrue="{!v.isOwner}">

            <lightning:layoutItem size="12" class="slds-m-top_large">
                <h3 class="slds-m-bottom_small red">Address Information</h3>
            </lightning:layoutItem>

            <div class="slds-size_12-of-12">

                <div class="grid -spacing-md">
                    <div class="grid_1-2 grid_1-sm">
                        <lightning:input required="true" aura:id="validateField" name="Address__c" type="text" label="" value="{!v.driverObject.Address__c}"
                                         placeholder="Address" variant="label-hidden"
                                         onchange="{!c.updateDriverField}"/>
                    </div>
                    <div class="grid_1-2 grid_1-sm">
                        <lightning:input name="Address_Line_2__c" type="text" label=""
                                         value="{!v.driverObject.Address_Line_2__c}" placeholder="Address (Line2)"
                                         variant="label-hidden" onchange="{!c.updateDriverField}"/>
                    </div>

                    <div class="grid_1-2 grid_1-sm">
                        <lightning:input required="true" aura:id="validateField" name="City__c" type="text" label="" value="{!v.driverObject.City__c}"
                                         placeholder="City" variant="label-hidden" onchange="{!c.updateDriverField}"/>
                    </div>
                    <div class="grid_1-2 grid_1-sm">
                        <!--aura:if isTrue="{!v.policyType == 'Northbound'}">
                            <lightning:input required="true" aura:id="validateField" name="Country__c" type="text" label="" value="{!v.driverObject.Country__c}"
                                             placeholder="Country" variant="label-hidden"
                                             onchange="{!c.updateDriverField}" disabled="{!v.disableCountryInput}"/>
                            <aura:set attribute="else"-->
                                <lightning:combobox required="true" aura:id="validateField" name="Country__c" label="Country" variant="label-hidden"
                                                    placeholder="Country" value="{!v.policyCountry}"
                                                    options="{! v.countryOption }" onchange="{!c.updateDriverField}"/>
                                <aura:if isTrue="{!v.showCountryInput}">
                                    <lightning:input required="true" aura:id="validateField" name="Country__c" type="text" label="" placeholder="Country"
                                                     variant="label-hidden" onchange="{!c.updateDriverField}"
                                                     value="{!v.policyCountryInput}"/>
                                </aura:if>
                            <!--/aura:set>
                        </aura:if-->
                    </div>

                    <div class="grid_1-2 grid_1-sm">
                        <lightning:input required="true" aura:id="validateField" name="Postal_Code__c" type="text" label=""
                                         value="{!v.driverObject.Postal_Code__c}" placeholder="Postal Code"
                                         variant="label-hidden" onchange="{!c.updateDriverField}"/>
                    </div>
                    <div class="grid_1-2 grid_1-sm">
                        <aura:if isTrue="{!v.showStatePick}">
                            <lightning:combobox required="true" aura:id="validateField" name="State_Province__c" label="State/Province" variant="label-hidden"
                                                placeholder="State/Province" value="{!v.driverObject.State_Province__c}"
                                                options="{! v.stateOptions }" onchange="{!c.updateDriverField}"/>
                            <aura:set attribute="else">
                                <lightning:input required="true" aura:id="validateField" name="State_Province__c" type="text" label=""
                                                 value="{!v.driverObject.State_Province__c}"
                                                 placeholder="State/Province" variant="label-hidden"
                                                 onchange="{!c.updateDriverField}"/>
                            </aura:set>
                        </aura:if>
                    </div>
                </div>
            </div>
        </aura:if>


        <lightning:layoutItem size="12" class="slds-m-top_large">
            <aura:if isTrue="{!v.policyType == 'Watercraft'}">
                <h3 class="slds-m-bottom_small red">Captain's/Owner's License Information</h3>
                <aura:set attribute="else">
                    <h3 class="slds-m-bottom_small red">Driver's License Information</h3>
                </aura:set>
            </aura:if>
        </lightning:layoutItem>

        <div class="slds-size_12-of-12">

            <div class="grid -spacing-md">
                <div class="grid_1-2 grid_1-sm">
                    <!--aura:if isTrue="{!v.policyType == 'Northbound'}">
                        <lightning:input required="true" aura:id="validateField" name="License_Country__c" type="text" label=""
                                         value="{!v.driverObject.License_Country__c}" placeholder="License Country"
                                         variant="label-hidden" onchange="{!c.updateDriverField}" maxlength="20"
                                         disabled="{!v.disableCountryLicenseInput}"/>
                        <aura:set attribute="else"-->
                            <lightning:combobox required="true" aura:id="validateField" name="License_Country__c" variant="label-hidden" label="License Country"
                                                placeholder="License Country" value="{!v.policyCountryLicense}"
                                                options="{! v.countryOption }" onchange="{!c.updateDriverField}"/>
                            <aura:if isTrue="{!v.showCountryLicenseInput}">
                                <lightning:input required="true" aura:id="validateField" name="License_Country__c" type="text" label=""
                                                 placeholder="License Country" variant="label-hidden"
                                                 onchange="{!c.updateDriverField}" maxlength="20"
                                                 value="{!v.policyCountryLicenseInput}"/>
                            </aura:if>
                        <!--/aura:set>
                    </aura:if-->
                </div>

                <div class="grid_1-2 grid_1-sm">
                    <aura:if isTrue="{!v.showStatePickLicense}">
                        <lightning:combobox required="true" aura:id="validateField" name="License_state__c" variant="label-hidden"
                                            label="License State / Province" placeholder="License State / Province"
                                            value="{!v.driverObject.License_state__c}"
                                            options="{! v.stateOptionsLicense }" onchange="{!c.updateDriverField}"/>
                        <aura:set attribute="else">
                            <lightning:input required="true" aura:id="validateField" name="License_state__c" type="text" label=""
                                             value="{!v.driverObject.License_state__c}"
                                             placeholder="License State / Province" variant="label-hidden"
                                             onchange="{!c.updateDriverField}" maxlength="20"/>
                        </aura:set>
                    </aura:if>
                </div>
                <div class="grid_1-2 grid_1-sm">
                    <lightning:input required="true" aura:id="validateField" name="license_number__c" type="text" label=""
                                     value="{!v.driverObject.license_number__c}" placeholder="License Number"
                                     variant="label-hidden" onchange="{!c.updateDriverField}" pattern="[A-Z0-9]+" messageWhenPatternMismatch ="Whitespace &#38; Special Characters (@, $, %, etc...) aren't allowed" />
                </div> 
            </div>
            <aura:if isTrue="{!and(v.policyType != 'Northbound', v.policyType != 'Watercraft')}">
                <div class="grid_1-2 grid_1-sm">
                    Mexican drivers licenses are not covered under this tourist auto insurance policy.
                </div>
            </aura:if>
            <aura:if isTrue="{!and(v.policyType == 'Watercraft')}">
                <div class="grid_1-2 grid_1-sm">
                    Mexican driver’s licenses are not eligible for tourist watercraft insurance.
                </div>
            </aura:if>
        </div>
    </lightning:layout>
</aura:component>