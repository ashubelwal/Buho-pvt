<aura:component controller="QuickQuotationCtrl" implements="flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction,lightning:isUrlAddressable" access="global" >
    <aura:handler event="aura:doneWaiting" action="{!c.hideSpinner}"/>
    <aura:handler event="aura:waiting" action="{!c.showSpinner}"/>    
    <aura:attribute name="screenName" type="String" />
    <aura:attribute name="communityUser" type="Boolean" default="false"/>
    <aura:attribute name="recordId" type="String" default="" />
    <aura:attribute name="policyType" type="String" />
    <aura:attribute name="spinner" type="boolean" default="false" />
    <aura:attribute name="quoteRecord" type="Quote__c" default="{ 'sobjectType': 'Quote__c'}" />
    <aura:attribute name="towedunitRecord" type="Towed_Unit__c" default="{ 'sobjectType': 'Towed_Unit__c'}" />
    <aura:attribute name="vehicleRecord" type="Vehicle__c" default="{ 'sobjectType': 'Vehicle__c'}" />
    <aura:attribute name="leadRecord" type="Lead" default="{ 'sobjectType': 'Lead'}"  />
    <aura:attribute name="rateRecord" type="object" access="public" />
    <aura:attribute name="waterRateRecord" type="object" access="public" />
    <aura:attribute name="rateRecordList" type="List" access="public" />
    <aura:attribute name="driverRecord" type="Driver__c" default="{ 'sobjectType': 'Driver__c'}"/>
    <aura:attribute name="drivers" type="List" access="public" />
    <aura:attribute name="transporates" type="List" access="public" />
    <aura:attribute name="quoteIds" type="List" access="public" />
    <aura:attribute name="anotherVehicle" type="String" default="No" access="public" />
    <aura:attribute name="highLiability" type="String" default="200,000"  />
    <aura:attribute name="lowLiability" type="String" default="100,000"  />
    <aura:attribute name="driverOptions" type="list"  />
    <aura:attribute name="vehicleTypeOptions" type="list"  />
    <aura:attribute name="policyMapList" type="list"  />
    <aura:attribute name="countVehicle" type="Integer" access="public" default="0" />
    <aura:attribute name="purchaseQuotePop" type="Boolean" default="false" />
    <aura:attribute name="firstName" type="String"  />
    <aura:attribute name="lastName" type="String"  />
    <aura:attribute name="emailAdder" type="String"/>
    <aura:attribute name="phoneNumber" type="String"/>
    
    <aura:attribute name="updateLeadData" type="boolean" default="true" />

    <aura:attribute name="policyRecord" type="Policy__c" default="{ 'sobjectType': 'Policy__c'}"/>
    <aura:attribute name="contactRecord" type="Contact" default="{ 'sobjectType': 'Contact'}"/>
    <aura:attribute name="affiliateAccount" type="Account" default="{ 'sobjectType': 'Account'}"/>

    <aura:attribute name="qualitasLiability" type="String" default="300000" />
    <aura:attribute name="qualitasMedical" type="String" default="$10,000/$50,000" />
    <aura:attribute name="chubbLiability" type="String" default="300000" />
    <aura:attribute name="chubbMedical" type="String" default="$10,000/$50,000" />
    <aura:attribute name="mapfreLiability" type="String" default="300000" />
    <aura:attribute name="mapfreMedical" type="String" default="$10,000/$50,000" />
    <aura:attribute name="qualitasLiablityOnly" type="Boolean" default="false" />
    <aura:attribute name="chubbLiablityOnly" type="Boolean" default="false" />
    <aura:attribute name="mapfreLiablityOnly" type="String" default="Max" />

    <aura:attribute name="addOtherUnit" type="Boolean" access="public"/>
	<aura:attribute name="Final_total_Premium" type="Decimal" access="public"/>
    
    <aura:attribute name="additional_towunit" type="object" />
    <aura:attribute name="additional_towunit_Index" type="Integer" default="0"/>
    <aura:attribute name="liabiltyOnly" type="Boolean" default="false" description="If rate not exist then make it true" />
    <aura:attribute name="minDate" type="String" />
    <aura:attribute name="endMinDate" type="String" />
    <aura:attribute name="vehicleMake" type="String" />
    <aura:attribute name="vehicleModel" type="String" />
    <aura:attribute name="days" type="Integer" />
	<aura:attribute name="annualTerm" type="boolean" default="false" />
    <ltng:require styles="{!$Resource.mexinsurance_assets + '/style.css'}" afterScriptsLoaded="{!c.doInit}"/>

    <!--********Payment******** -->
    <aura:handler name="paymentIsSuccessful" event="c:paymentIsSuccessful" action="{!c.handleNext}"/>

    <!--********Spinner******** -->
    <aura:if isTrue="{!v.spinner}">
        <lightning:spinner alternativeText="Loading" variant="brand" />
    </aura:if> 
    
    <!--********Header******* *-->
    <header class="page-header">
        <div class="wrap">
            <a href="javascript.void(0)"><img src="{!$Resource.mexinsurance_assets + '/images/logo-mexinsurance.png'}"/></a>
        </div>
    </header>

    <div class="wrap -size-md">
        <lightning:layout multipleRows="true">

            <aura:if isTrue="{!v.screenName == 'UserInfo'}">
                <c:Lead_Generate_steps step="step1" completedStep="1"/>
                <c:UserInfo_Screen_Detail quoteRecord="{!v.quoteRecord}" leadRecord="{!v.leadRecord}" backButtonVisibility="false"
                                          iscommunityUser="{!v.communityUser}" policyType="{!v.policyType}" title="Please fill in some details below:"
                                          onBackClick="{!c.handleBack}" onNextClick="{!c.handleNext}" />
            </aura:if>

            <!--********Please fill in vehicle options below:******* *-->
            <aura:if isTrue="{!v.screenName == 'VehicleOptions'}">
                <c:Lead_Generate_steps step="step2" completedStep="2"/>
                <c:Vehicle_Detail quoteRecord="{!v.quoteRecord}" leadRecord="{!v.leadRecord}" backButtonVisibility="{!!v.communityUser}"
                                  vehicleRecord ="{!v.vehicleRecord}" iscommunityUser="{!v.communityUser}" liabiltyOnly="{!v.liabiltyOnly}"
                                  policyType="{!v.policyType}" title="Please fill in vehicle details below:" onBackClick="{!c.handleBack}"
                                  onNextClick="{!c.handleNext}" 
                                  vehicleMake="{!v.vehicleMake}" vehicleModel="{!v.vehicleModel}"/> 
            </aura:if>

            <!--********Please select term options:******* *-->
            <aura:if isTrue="{!v.screenName == 'TermOptions'}">
                <c:Lead_Generate_steps step="step3" completedStep="3"/>
                <c:Term_Option quoteRecord="{!v.quoteRecord}" leadRecord="{!v.leadRecord}" minDate="{!v.minDate}" endMinDate="{!v.endMinDate}"
                               policyType="{!v.policyType}" title="Please select term options" onBackClick="{!c.handleBack}"
                               onNextClick="{!c.handleNext}" />
            </aura:if>

            <!--********Are you towing anything?:******* *-->
            <aura:if isTrue="{!v.screenName == 'TowningAnything'}">
                <c:Lead_Generate_steps step="step4" completedStep="4"/>
                <c:Towing_Anything quoteRecord="{!v.quoteRecord}" leadRecord="{!v.leadRecord}"
                                   policyType="{!v.policyType}" title="Are you towing anything?" onBackClick="{!c.handleBack}"
                                   transporates="{!v.transporates}"
                                   onNextClick="{!c.handleNext}" />
            </aura:if>

            <!--********Tell us more about what you're towing?******* *-->
            <!--aura:if isTrue="{!v.screenName == 'TowningInfo'}">
                <c:Towing_Info quoteRecord="{!v.quoteRecord}" towedunitRecord="{!v.towedunitRecord}"
                               policyType="{!v.policyType}" title="Tell us more about what you're towing?" 
                               addOtherUnit="{!v.addOtherUnit}" onBackClick="{!c.handleBack}"
                               onNextClick="{!c.handleNext}" />
            </aura:if -->

            <!--********Tell us more about what you're towing?******* *-->
            <!-- Add transported ATV's -->
            <aura:if isTrue="{!v.screenName == 'Transporte'}">
                <c:Add_TransporateAtvs quoteRecord="{!v.quoteRecord}" transporates="{!v.transporates}" isCommunityUser="{!v.communityUser}"
                                        vehicleRecord="{!v.vehicleRecord}"
                                       policyType="{!v.policyType}" title="Tell us more about what you're towing?" onBackClick="{!c.handleBack}"
                                       onNextClick="{!c.handleNext}" />
            </aura:if>

            <!--********What territory coverage are you looking for:******* *-->
            <aura:if isTrue="{!v.screenName == 'TerritoryCoverage'}">
                <c:Lead_Generate_steps step="step5" completedStep="5"/>
                <lightning:layoutItem padding="around-small" size="12" class="align-center slds-m-top_xx-large">
                    <div class="page-title">
                        <button class="button -plain -back-button" name="step_3" onclick="{!c.handleBack}">
                            <img class="icon-back" src="{!$Resource.mexinsurance_assets + '/images/icon-back.svg'}" alt="Back"/> Back
                        </button>
                        <h1>What territory coverage are you looking for?</h1>
                        <img class="slds-m-bottom_large" src="{!$Resource.mexinsurance_assets + '/images/icon-driver-license.svg'}" alt="Vehicle"/>
                    </div>
                </lightning:layoutItem>                    
                
                <lightning:layoutItem padding="around-small" size="12" class="slds-align_absolute-center">
                    <lightning:layoutItem padding="around-small" size="4" class="slds-m-top_large">
                        <div class="align-center">
                            <div class="selection-icon">
                                <!--img width="137" src="{!$Resource.mexinsurance_assets + '/images/map-mexico-full@2x.png'}" alt="Baja / Sonora"/-->
                                <img  width="137" src="{!$Resource.mexJs  + '/mexJs/images/MexicoBajaSonora.png'}" alt="Baja / Sonora"/>
                            </div>
                            <label class="label-large slds-m-top_small slds-m-bottom_small">Baja / Sonora</label>
                            <label class="radiocontainer">
                                <ui:inputRadio aura:id="r1" name="Territory_Coverage__c" value="{!v.quoteRecord.Territory_Coverage__c == 'Baja Sonora'}" text="Baja Sonora" class="radio_box slds-m-top_x-small" change="{!c.onGroup}"/>
                                <span class="radiobtn"></span>
                            </label>
                        </div>
                    </lightning:layoutItem>    
                <lightning:layoutItem padding="around-small" size="4" class="slds-m-top_large">
                        <div class="align-center">
                            <div class="selection-icon">
                                <img width="137" src="{!$Resource.mexinsurance_assets + '/images/max-mexico-partial@2x.png'}" alt="Mexico Partial"/>
                            </div>
                            <label class="label-large slds-m-top_small slds-m-bottom_small">
                                Partial (US Adjacent)<br/>
                                <div style="font-size: 0.9rem;">(Baja, Sonora, Chihuahua, Coahuila, Nuevo Leon, Tamaulipas)</div>
                            </label>
                            <label class="radiocontainer">
                                <ui:inputRadio aura:id="r0" name="Territory_Coverage__c" value="{!v.quoteRecord.Territory_Coverage__c == 'Partial (US Adjacent)'}" text="Partial (US Adjacent)" class="radio_box slds-m-top_x-small" change="{!c.onGroup}"/>
                                <span class="radiobtn"></span>
                            </label>
                        </div>
                    </lightning:layoutItem>
                    <lightning:layoutItem padding="around-small" size="4" class="slds-m-top_large">
                        <div class="align-center">
                            <div class="selection-icon">
                                <img width="137" src="{!$Resource.mexinsurance_assets + '/images/map-mexico-full@2x.png'}" alt="Entire Mexico"/>
                            </div>  
                            <label class="label-large slds-m-top_small slds-m-bottom_small">Entire Mexico</label>
                            <label class="radiocontainer">
                                <ui:inputRadio aura:id="r1" name="Territory_Coverage__c" value="{!v.quoteRecord.Territory_Coverage__c == 'Entire Mexico'}" text="Entire Mexico" class="radio_box slds-m-top_x-small" change="{!c.onGroup}"/>
                                <span class="radiobtn"></span>
                            </label>
                        </div>
                    </lightning:layoutItem>
                    
                </lightning:layoutItem>
                
                <lightning:layoutItem padding="around-small" size="12" class="slds-m-top_large align-center">
                    <button class="button -secondary -wider" onclick="{!c.handleNext}">Next</button>
                </lightning:layoutItem>
            </aura:if>

            <!--********southbound_Car_Truck_Auto information******* *-->
            <aura:if isTrue="{!v.screenName == 'southbound_Quick_Quote_Detail'}">
               <c:southbound_Quick_Quote_Detail quoteRecord="{!v.quoteRecord}" countVehicle="1" rateRecord="{!v.rateRecord}"
                                                 leadRecord = "{!v.leadRecord}" communityUser="{!v.communityUser}"
                                                 policyType="{!v.policyType}" title="Get your quick quote!"
                                                 onBackClick="{!c.handleBack}" onNextClick="{!c.handleNext}"
                                                 qualitasLiability="{!v.qualitasLiability}" qualitasMedical="{!v.qualitasMedical}"
                                                 chubbLiability="{!v.chubbLiability}" chubbMedical="{!v.chubbMedical}"
                                                 mapfreLiability="{!v.mapfreLiability}" mapfreMedical="{!v.mapfreMedical}"
                                                 qualitasLiablityOnly="{!v.qualitasLiablityOnly}" chubbLiablityOnly="{!v.chubbLiablityOnly}"
                                                 mapfreLiablityOnly="{!v.mapfreLiablityOnly}"
                                                 liabiltyOnly="{!v.liabiltyOnly}" 
                                                 minDate="{!v.minDate}" endMinDate="{!v.endMinDate}" />
            </aura:if>


            <!--********southbound_Car_Truck_Auto information******* *-->
            <aura:if isTrue="{!v.screenName == 'aditional_Quick_Quote_Detail'}">
                <aura:if isTrue="{!v.additional_towunit.Towed_Unit_Type__c == 'Boat'}">
                    <c:Watercraft_Quick_Quote_Detail primaryquoteRecord="{!v.quoteRecord}" additional_towunit="{!v.additional_towunit}" additional_quoteRecord="{!v.additional_towunit.quoteRecord}"
                                                     leadRecord = "{!v.leadRecord}" communityUser="{!v.communityUser}"
                                                     rateRecord="{!v.waterRateRecord}" towedpolicyType="{!v.policyType}" title="You are eligble to ensure your detached ATV(s)" annualTerm="{!v.annualTerm}"
                                                     onBackClick="{!c.handleBack}" onNextClick="{!c.handleNext}"
                                                     days="{!v.days}" />
                </aura:if>
                <aura:if isTrue="{!v.additional_towunit.Towed_Unit_Type__c != 'Boat'}">
                        <c:southbound_Quick_Quote_Detail primaryquoteRecord="{!v.quoteRecord}" additional_towunit="{!v.additional_towunit}" 
                                                         additional_towunit_Index="{!v.additional_towunit_Index}"  additional_quoteRecord="{!v.additional_towunit.quoteRecord}" countVehicle="2" 
                                                         leadRecord = "{!v.leadRecord}" communityUser="{!v.communityUser}"
                                                         towedpolicyType="{!v.policyType}" title="You are eligble to ensure your detached ATV(s)"
                                                         onBackClick="{!c.handleBack}" onNextClick="{!c.handleNext}" 
                                                         qualitasLiability="{!v.additional_towunit.qualitasLiability}" qualitasMedical="{!v.additional_towunit.qualitasMedical}"
                                                         chubbLiability="{!v.additional_towunit.chubbLiability}" chubbMedical="{!v.additional_towunit.chubbMedical}"
                                                         mapfreLiability="{!v.additional_towunit.mapfreLiability}" mapfreMedical="{!v.additional_towunit.mapfreMedical}"
                                                         qualitasLiablityOnly="{!v.additional_towunit.qualitasLiablityOnly}" chubbLiablityOnly="{!v.additional_towunit.chubbLiablityOnly}"
                                                         mapfreLiablityOnly="{!v.additional_towunit.mapfreLiablityOnly}"
                                                         liabiltyOnly="{!v.liabiltyOnly}" 
                                                         minDate="{!v.minDate}"  endMinDate="{!v.endMinDate}"/>
                    </aura:if>
            </aura:if>

            <!--********Review vehicle information******* *-->
            <aura:if isTrue="{!v.screenName == 'ReviewVehicle'}">
                <c:Review_Vehicle quoteRecord="{!v.quoteRecord}" vehicleRecord="{!v.vehicleRecord}" leadRecord="{!v.leadRecord}"
                                  policyType="{!v.policyType}" title="Review vehicle information" onBackClick="{!c.handleBack}"
                                  onNextClick="{!c.handleNext}" communityUser="{!v.communityUser}" />
            </aura:if>

            <!--********Company information******* *-->
            <aura:if isTrue="{!v.screenName == 'CompanyInfo'}">
                <c:Company_Info quoteRecord="{!v.quoteRecord}" vehicleRecord="{!v.vehicleRecord}" leadRecord = "{!v.leadRecord}"
                                policyType="{!v.policyType}" title="Company information" onBackClick="{!c.handleBack}"
                                onNextClick="{!c.handleNext}" />
            </aura:if>

            <!--********Company information******* *-->
            <aura:if isTrue="{!v.screenName == 'LienHolder'}">
                <c:LienHolder_Info quoteRecord="{!v.quoteRecord}" leadRecord = "{!v.leadRecord}" vehicleRecord="{!v.vehicleRecord}"
                                   policyType="{!v.policyType}" title="Lienholder Information" onBackClick="{!c.handleBack}"
                                   onNextClick="{!c.handleNext}" />
            </aura:if>

            <!--********Owner of the Registered Vehicle******* *-->
            <aura:if isTrue="{!v.screenName == 'RegisteredVehicle'}">
                <c:Driver_Registration quoteRecord="{!v.quoteRecord}" driverRecord="{!v.driverRecord}" leadRecord = "{!v.leadRecord}"
                                       drivers="{!v.drivers}" isCommunityUser="{!v.communityUser}"
                                       vehicleRecord="{!v.vehicleRecord}"
                                       policyType="{!v.policyType}" title="Review vehicle information" onBackClick="{!c.handleBack}"
                                       onNextClick="{!c.handleNext}" />
            </aura:if>

            <!--********Would you like to insure another vehicle?******* *-->
            <aura:if isTrue="{!v.screenName == 'AnotherVehicle'}">
                <c:Another_Vehicle quoteRecord="{!v.quoteRecord}" anotherVehicle="{!v.anotherVehicle}"
                                   policyType="{!v.policyType}" title="Would you like to insure another vehicle?" onBackClick="{!c.handleBack}"
                                   onNextClick="{!c.handleNext}" />
            </aura:if>

            <!-- *Start Quote Detail 1 Page * -->
            <aura:if isTrue="{!v.screenName == 'QuoteDetail' }" >
                <lightning:layoutItem padding="around-small" size="12" class="slds-align_absolute-center">
                    <c:verifyEditQuoteDetail policyType="{!v.policyType}" quoteRecord="{!v.quoteRecord}"
                                             vehicleTypeOptions="{!v.vehicleTypeOptions}" quoteIds="{!v.quoteIds}"
                                             Final_total_Premium="{!v.Final_total_Premium}"
                                             rateObectList="{!v.rateRecordList}" onbackClick="{!c.handleBack}"
                                             isCommunityUser="{!v.communityUser}" />
                </lightning:layoutItem>
                
                <lightning:layoutItem padding="around-small" size="12" class="slds-align_absolute-center slds-m-top_large">
                    <button class="button -secondary -wider -margin-left" name="step_12" onclick="{! c.handleNext }" >Confirm</button>
                </lightning:layoutItem>
            </aura:if>

            <!-- START*Payment Page* -->
            <aura:if isTrue="{!v.screenName == 'PaymentDetail'}">
                <c:Insurance_Flow_Steps step="step5" completedStep="5"/>

                <lightning:layoutItem padding="around-small" size="12" class="slds-align-center slds-m-top_xx-large">
                    <div class="page-title">
                        <button class="button -plain -back-button" name="step_14" onclick="{! c.handleBack }">
                            <img class="icon-back" src="{!$Resource.mexinsurance_assets + '/images/icon-back.svg'}" alt="Back"/> Back
                        </button>
                        <h1>Let's tackle the Payment now</h1>                        
                    </div>
                </lightning:layoutItem>

                <c:paymentForm screenName="{!v.screenName}"  
                               drivers="{!v.drivers}"
                               Final_total_Premium="{!v.Final_total_Premium}"
                               policyType="{!v.quoteRecord.Policy_Type_picklist__c}"
                               onBackClick="{!c.handleBack}" communityUser="{!v.communityUser}" quoteIds="{!v.quoteIds}" quoteId="{!v.quoteRecord.Id}" quoteRecord="{!v.quoteRecord}"></c:paymentForm>
            </aura:if>

            <!-- ***************Start Online Insurance Final Details*************** -->
            <aura:if isTrue="{!v.screenName == 'InsuranceFinalDetail' }">
                
                <c:Insurance_Final_Detail quoteIds="{!v.quoteIds}" rateRecordList="{!v.rateRecordList}"
                                          policyMapList="{!v.policyMapList}" isCommunityUser="{!v.communityUser}"
                                          policyType="{!v.policyType}" title="Online Insurance Final Details" onBackClick="{!c.handleBack}"
                                          onNextClick="{!c.handleNext}" quoteRecord="{!v.quoteRecord}" />
            </aura:if>

            <!-- START*Payment Page* --> 
            <aura:if isTrue="{!v.screenName == 'PolicyDetail'}">
                <c:Policy_Detail policyMapList="{!v.policyMapList}" quoteRecord="{!v.quoteRecord}" quoteIds="{!v.quoteIds}" iscommunityUser="{!v.communityUser}"/>
            </aura:if>
        </lightning:layout>
    </div>
</aura:component>