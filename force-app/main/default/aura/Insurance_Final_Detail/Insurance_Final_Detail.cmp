<aura:component controller="QuickQuotationCtrl" implements="forceCommunity:availableForAllPageTypes" access="global" >
    <aura:attribute name="title" type="String" access="public"/>
    <aura:attribute name="backButtonVisibility" type="Boolean" default="false" access="public" />
    <aura:attribute name="policyType" type="String" access="public"/>
    <aura:attribute name="underwriter" type="String" access="public"/>
    <aura:attribute name="onBackClick" type="Aura.Action"/>
    <aura:attribute name="onNextClick" type="Aura.Action"/>
    <aura:attribute name="quoteIds" type="List" access="public" />
    <aura:attribute name="usDestinations" type="List" access="public" />
    <aura:attribute name="tripPurposes" type="List" access="public" />
    <aura:attribute name="aboutusOption" type="List" access="public" />
    <aura:attribute name="rateRecordList" type="List" access="public" />
    
    <aura:attribute name="isCommunityUser" type="Boolean" access="public" />
    <aura:attribute name="quoteRecord" type="Quote__c" default="{ 'sobjectType': 'Quote__c'}" access="public" />

    <aura:attribute name="policyMapList" type="list"  />
    
	<aura:attribute name="policyRecord" type="Policy__c" default="{ 'sobjectType': 'Policy__c'}"/>
    <aura:attribute name="contactRecord" type="Contact" default="{ 'sobjectType': 'Contact'}"/>
    <aura:attribute name="legalTermRecord" type="Legal_Term__c" default="{ 'sobjectType': 'Legal_Term__c'}"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <c:Insurance_Flow_Steps step="step4" completedStep="4"/>
    
    <lightning:layoutItem padding="around-small" size="12" class="align-center slds-m-top_xx-large">
        <div class="page-title">
            <button class="button -plain -back-button" name="step_13" onclick="{! v.onBackClick }">
                <img class="icon-back" src="{!$Resource.mexinsurance_assets + '/images/icon-back.svg'}" alt="Back"/> Back
            </button>
            <h1>Online Insurance Final Details</h1>                        
            <img class="slds-m-bottom_large" src="{!$Resource.mexinsurance_assets + '/images/icon-finish.svg'}" alt="Final Details"/>
        </div>
    </lightning:layoutItem>
    
    
    <div class="slds-size_12-of-12">
        <div class="form-container">
            <lightning:combobox name="What_is_your_trip_destination_in_US__c" variant="label-hidden" placeholder="What is your trip destination?" options="{!v.usDestinations}" value="{!v.policyRecord.What_is_your_trip_destination_in_US__c}" onchange="{!c.updatePolicyField}"  />
            <lightning:combobox name="What_is_the_purpose_of_trip__c" variant="label-hidden" placeholder="What is the trip purpose trip?"  options="{!v.tripPurposes}" value="{!v.policyRecord.What_is_the_purpose_of_trip__c}" onchange="{!c.updatePolicyField}" />
            <lightning:combobox name="How_did_you_hear_about_us__c" variant="label-hidden"  placeholder="How did you hear about us?" options="{!v.aboutusOption}" value="{!v.contactRecord.How_did_you_hear_about_us__c}" onchange="{!c.updateContactField}" />
            
            <aura:if isTrue="{!v.contactRecord.How_did_you_hear_about_us__c == 'Other'}" >
                <lightning:textarea name="How_did_you_hear_about_us_Other__c" placeholder="How did you hear about us?" variant="label-hidden" value="{!v.contactRecord.How_did_you_hear_about_us_Other__c}" onchange="{!c.updateContactField}" />
            </aura:if>
            <h3 class="red slds-m-top_large slds-m-bottom_medium">Yes, I want to receive the following:</h3>
            <div class="radio-group">
                <lightning:input type="checkbox" name="Newsletter__c" label="Newsletter" checked="{!v.contactRecord.Newsletter__c == 'Yes'}" onchange="{!c.updateContactField}" />
                <lightning:input type="checkbox" name="Announcements__c" label="Announcements" checked="{!v.contactRecord.Announcements__c == 'Yes'}" onchange="{!c.updateContactField}" />
                <lightning:input type="checkbox" name="Travel_Alerts__c" label="Travel Alerts" checked="{!v.contactRecord.Travel_Alerts__c == 'Yes'}" onchange="{!c.updateContactField}" />
            </div>
            
            <h3 class="red slds-m-top_large slds-m-bottom_medium">I read and agree with the following:</h3>
            
            <lightning:input aura:Id="validateField" type="checkbox" name="Terms_of_Purchase_Confirmed__c" label="Terms of purchase" required="true" checked="{!v.policyRecord.Terms_of_Purchase_Confirmed__c}" onchange="{!c.updatePolicyField}" />
            
            <!--lightning:textarea value=""/-->
            <div class="slds-textarea" style="overflow-y: scroll;height: 200px;">
                <aura:if isTrue="{!or(v.policyType == 'Automobile', v.policyType == 'Driver License')}">
                    <p>{! v.legalTermRecord.Terms_of_Purchase_and_Use__c }</p>
                </aura:if>
                <aura:if isTrue="{!or(v.policyType == 'Watercraft', v.policyType == 'RV')}">
                    <p>{! v.legalTermRecord.Terms_of_Purchase_and_Use__c }</p>
                </aura:if>
                <aura:if isTrue="{! or(v.policyType == 'Motorcycle/Street Legal ATV')}">
                	<p>{! v.legalTermRecord.Terms_of_Purchase_and_Use__c }</p>
                </aura:if>
                <aura:if isTrue="{! or(v.policyType == 'Northbound')}">
                	<p>{! v.legalTermRecord.Terms_of_Purchase_and_Use__c }</p>
                </aura:if>
                <!--<aura:if isTrue="{! and(v.policyType != 'Watercraft', v.policyType != 'Driver License') }">
                    <aura:if isTrue="{! and(v.policyType != 'RV', v.policyType != 'Motorcycle/Street Legal ATV') }">
                        <p>I agree to the following when I click the “next” button to purchase northbound insurance.</p>
                        <p>I have read, understand, and agree to the Terms of Access and Use.  The Mexico Insurance Services “Terms of Access and Use” can be read and printed by <a href="https://www.mexinsurance.com/legal/terms/" target="_blank" >clicking here</a> </p>
                        <p>I understand and agree to the insurance policy contract of the Northbound Auto Insurance policy made between me (the insured) and the insurance company (Chubb Seguros).  The full Chubb “Terms and Conditions” can be read and printed by <a href="https://www.mexinsurance.com/legal/terms/" target="_blank" >clicking here</a></p>
                        <p>I understand and agree that coverage applies only to the vehicles and towed units that I have listed on the policy and coverage will not exceed the maximum values/limits specified. </p>
                        <p>I understand and agree that I will only be insured between the beginning and ending date and time I have specified during this application process.
                            I agree that I have reviewed the information I entered during the application process and that I have answered all of the questions and listed all of the vehicle information truthfully.
                        </p>
                        <p>I understand and agree that this northbound auto insurance policy is issued by a Mexican insurance company pursuant to the laws of Mexico.  The policy is a standard policy of insurance approved by the Insurance Commission in the country of Mexico (Comision de Seguros y Fianzas).  </p>
                        <p>I understand and agree that the laws of Mexico do not authorize certain types of coverage sometimes found in automobile insurance policies issued in the United States or in Canada.</p>
                        <p>I understand and agree that this “tourist” Northbound Insurance only provides coverage in the United States and Canada and is subject to the laws of the United States and Canada.</p>
                        <p>I understand and agree that I must print the insurance policy declaration page.</p>
                        <p>I understand and agree that the policy declarations page will be available to print at the time of purchase, and the policy declarations page can also be accessed and printed by logging into my account at this website.</p>
                        <p>I understand and agree that the policy “Northbound Terms and Conditions” can also be printed from this website at any time.</p>
                        <p>I understand and agree that I must report all claims to the insurance company prior to leaving the country.</p>
                        <p>I understand and agree that failure to report the claim while in Mexico could result in the claim being denied.</p>
                        <p>I understand and agree that this “tourist” Northbound auto insurance policy does NOT cover U.S. or Canadian plated vehicles as it is specifically for vehicles registered in the Republic of Mexico.  Accidents must be reported to Chubb Seguros before I return to Mexico.
                        </p>
                    </aura:if>
                </aura:if>-->
            </div>
            
            <lightning:input aura:Id="validateField" type="checkbox" class="slds-m-top_large" name="Terms_of_Cancellation_Confirmed__c" required="true" label="Terms of cancellation" checked="{!v.policyObject.Terms_of_Cancellation_Confirmed__c}" onchange="{!c.updatePolicyField}" />
            
            <!--lightning:textarea value="Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum. Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo. Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt. Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed quia non numquam eius modi tempora incidunt ut labore et dolore magnam aliquam quaerat voluptatem."/-->
            <div class="slds-textarea" style="overflow-y: scroll;height: 200px;">
                <aura:if isTrue="{! or( v.policyType == 'Watercraft', v.policyType == 'Automobile') }">
                    <p>{! v.legalTermRecord.Terms_of_Cancellation__c }</p>
                    <p>{! v.legalTermRecord.Daily_Policy_Cancellation__c }</p>
                    <p>{! v.legalTermRecord.Semi_Annual_and_Annual_Policy_Cancellati__c }</p>
                </aura:if>
                <aura:if isTrue="{!or(v.policyType == 'RV', v.policyType == 'Motorcycle/Street Legal ATV')}">
                    <p>{! v.legalTermRecord.Terms_of_Cancellation__c }</p>
                    <p>{! v.legalTermRecord.Daily_Policy_Cancellation__c }</p>
                    <p>{! v.legalTermRecord.Semi_Annual_and_Annual_Policy_Cancellati__c }</p>
                </aura:if>
                <aura:if isTrue="{!and(v.policyType != 'Watercraft', v.policyType != 'Automobile')}">
                    <aura:if isTrue="{! and(v.policyType != 'RV', v.policyType != 'Motorcycle/Street Legal ATV') }">
                        <p>The following are Terms of Cancellation, a legal agreement (“Agreement”) between you and Mexico Insurance Services, Inc. (“Company”).  By accepting the Terms of Purchase above, you also agree that you accept the Terms of Cancellation below.  These Cancellations Terms are strictly enforced by the underwriter, Chubb Seguros.  Any misrepresentation or attempts to violate these terms may be constituted as attempted fraud and will be forwarded to the appropriate authorities.</p>
                        <p>When the Contracting Party requests the early termination of this contract, it will be sufficient to present a written request in the offices of the Insurer; likewise, the request may be submitted through electronic means, through which, if applicable, the insurance was contracted. The Insurer, once it ascertains the authenticity and veracity of the Contracting Party's request, will grant the corresponding acknowledgment of receipt.</p>
                        <p><b>Daily Policy Cancellation</b> Daily term policies are fully earned as soon as coverage begins.  There are no cancellations on daily term policies.  You may cancel online prior to term inception.
                        </p>
                        <p><b>Semi-Annual and Annual Policy Cancellation</b>Semi-annual and Annual policies are fully earned after 22 days.  Prior to 22 days, you can cancel a policy and the premium will be short-rated to a daily rate.  Before inception, you can cancel any policy.
                        </p>
                        <p>All cancellations will be assessed a nominal cancellation fee.</p>
                    </aura:if>
                </aura:if>
            </div>  
        </div>
    </div> 
    
    <lightning:layoutItem padding="around-small" size="12" class="slds-align_absolute-center slds-m-top_large">
        <button class="button -secondary -wider" name="step_13" onclick="{! c.onNextClick }">Next</button>
    </lightning:layoutItem>
</aura:component>