                                                                        <aura:set attribute="else">
                                                                            <div class="slds-text-align_right">
                                                                                <lightning:formattedNumber value="{!v.coverageMap.Qualitas.Collision_Deductible__c}" style="currency" currencyCode="USD" />
                                                                            </div>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </aura:if>
                                                            </aura:if>
                                                        </div>
                                                        
                                                        <div class="highlight-title" style="padding-left: 15px">
                                                            Total Theft Deductible
                                                            <aura:if isTrue="{!or(v.policyType == 'Automobile')}">
                                                                <span style="position: absolute;right: 0;">
                                                                    <aura:if isTrue="{!empty(v.auto_theft_Total)}">
                                                                        N/A
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber value="{!v.auto_theft_Total}" style="currency" currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </span>
                                                            </aura:if>
                                                            <aura:if isTrue="{!or(v.policyType == 'RV')}">
