<aura:component controller="QuickQuotationCtrl" implements="forceCommunity:availableForAllPageTypes" access="global" >
    <aura:attribute name="title" type="String" access="public"/>
    <aura:attribute name="communityUser" type="Boolean" access="public" default="false"/>
    <aura:attribute name="backButtonVisibility" type="Boolean" default="false" access="public" />
    <aura:attribute name="saveQuotePop" type="Boolean" default="false" />
    <aura:attribute name="purchaseQuotePop" type="Boolean" default="false" />
    <aura:attribute name="clickedItemValue" type="String" />
    
    <aura:attribute name="policyType" type="String" access="public"/>
    <aura:attribute name="towedpolicyType" type="String" access="public"/>
    <aura:attribute name="rateRecord" type="object" access="public" />
    <aura:attribute name="countVehicle" type="Integer" access="public" />
    <aura:attribute name="liability" type="String" default="200,000" />
    <aura:attribute name="highLiability" type="String"  />
    <aura:attribute name="lowLiability" type="String"  />
    <aura:attribute name="firstName" type="String"  />
    <aura:attribute name="lastName" type="String"  />
    <aura:attribute name="emailAdder" type="String"/>
    <aura:attribute name="phoneNumber" type="String"/>
    
    <aura:attribute name="onBackClick" type="Aura.Action"/>
    <aura:attribute name="onNextClick" type="Aura.Action"/>
    <aura:attribute name="normalView" type="boolean" default="true" />
    <aura:attribute name="highlightView" type="boolean" default="false" />
    <aura:attribute name="coverageDetail" type="object"/>
    <aura:attribute name="coverageMap" type="Map" />
    <aura:attribute name="maincoverageMap" type="Map" />
    <aura:attribute name="quoteRecord" type="Quote__c" default="{ 'sobjectType': 'Quote__c'}" access="public"/>
    <aura:attribute name="leadRecord" type="Lead" default="{ 'sobjectType': 'Lead'}" access="public"/>
    
    <aura:attribute name="physicalDamagePayment" type="decimal" />
    <aura:attribute name="LiabilityPayment" type="decimal" />
    <aura:attribute name="medicalPayment" type="decimal" />
    <aura:attribute name="platinumEndorsementPayment" type="decimal" />
    <aura:attribute name="totalTheftPayment" type="decimal" />
    
    <aura:attribute name="primaryquoteRecord" type="Quote__c" default="{ 'sobjectType': 'Quote__c'}" access="public"/>
    <aura:attribute name="liabilitylist" type="list"/>
    <aura:attribute name="medicallist" type="list"/>
    <aura:attribute name="qualitasRateValue" type="decimal" />
    <aura:attribute name="chubbRateValue" type="decimal" />
    <aura:attribute name="mapfreRateValue" type="decimal" />
    <aura:attribute name="qualitasLiability" type="String" default="300000" />
    <aura:attribute name="qualitasMedical" type="String" default="$10,000/$50,000" />
    
    <aura:attribute name="chubbLiability" type="String" default="300000" />
    <aura:attribute name="chubbMedical" type="String" default="$10,000/$50,000" />
    
    <aura:attribute name="mapfreLiability" type="String" default="300000" />
    <aura:attribute name="mapfreMedical" type="String" default="$10,000/$50,000" />
    
    <aura:attribute name="qualitasLiablityOnly" type="Boolean" default="false" />
    <aura:attribute name="chubbLiablityOnly" type="Boolean" default="false" />
    <aura:attribute name="mapfreLiablityOnly" type="String" default="Max" />
    
    <aura:attribute name="qualitasBroker_Policy_Fee" type="decimal" />
    <aura:attribute name="chubbBroker_Policy_Fee" type="decimal" />
    <aura:attribute name="mapfreBroker_Policy_Fee" type="decimal" />
    
    <aura:attribute name="legalAssist_Policy_Fee" type="decimal" />
    <aura:attribute name="mapfreMedicalPayments_Fee" type="decimal" />
    
    <aura:attribute name="auto_collision_deductible" type="decimal" />
    <aura:attribute name="auto_theft_Total" type="decimal" />
    <aura:attribute name="auto_mapfre_collision_deductible" type="decimal" />
    <aura:attribute name="auto_mapfre_theft_Total" type="decimal" />
    
    <aura:attribute name="rv_collision_deductible" type="decimal" />
    <aura:attribute name="rv_theft_Total" type="decimal" />
    
    <aura:attribute name="moto_qual_collision_deductible" type="decimal" />
    <aura:attribute name="moto_qual_theft_Total" type="decimal" />
    <aura:attribute name="moto_map_collision_deductible" type="decimal" />
    <aura:attribute name="moto_map_theft_Total" type="decimal" />
    <aura:attribute name="qualitas_Iva" type="decimal" />
    <aura:attribute name="mapfre_iva" type="decimal" />
    <aura:attribute name="qualitas_Surcharge" type="decimal" />
    <aura:attribute name="chub_SurCharge" type="decimal" />
    
    <aura:attribute name="Final_total_Premium" type="Decimal" />
    
    <aura:attribute name="additional_towunit" type="object" />
    <aura:attribute name="additional_quoteRecord" type="object" />
    <aura:attribute name="additional_towunit_Index" type="Integer" default="0" />
    <aura:attribute name="days" type="Integer" default="0" />
    <aura:attribute name="isMedicalPayment" type="Boolean" default="true" />
    <aura:attribute name="showQualitas" type="Boolean" default="true" />
    <aura:attribute name="showChubb" type="Boolean" default="true" />
    <aura:attribute name="showMapfre" type="Boolean" default="true" />

    <aura:attribute name="liabilityshowQualitas" type="Boolean" default="true" />
    <aura:attribute name="liabilityshowChubb" type="Boolean" default="true" />
    <aura:attribute name="liabilityshowMapfre" type="Boolean" default="true" />

    <aura:attribute name="daysTootip" type="String" />
    <aura:attribute name="daysIntowTootip" type="String" />
    <aura:attribute name="minDate" type="String" />
    <aura:attribute name="endMinDate" type="String" />

    <aura:attribute name="liabiltyOnly" type="Boolean" default="false" />
    <aura:attribute name="renewPolicy" type="Boolean" default="false" />
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <c:Insurance_Flow_Steps step="step1"/>
    <lightning:layoutItem padding="around-small" size="12" class="align-center slds-m-top_xx-large">
        <div class="page-title">
            <button class="button -plain -back-button" name="step_5" onclick="{! v.onBackClick }">
                <img class="icon-back" src="{!$Resource.mexinsurance_assets + '/images/icon-back.svg'}" alt="Back"/> Back
            </button>
            <aura:if isTrue="{!v.additional_towunit}" >
                {!v.title}
            </aura:if>
            <aura:if isTrue="{!!v.additional_towunit}" >
                <b>About your Quotes: </b> Sometimes it's cheaper to purchase a six-month policy than it is a 30-day-policy. Below are the best rates offered for the time period you selected. If your selection in days was more expensive at the Daily rate, then we automatically adjusted it to a less expensive, longer term.
            </aura:if>
        </div>
    </lightning:layoutItem> 

    <lightning:layoutItem size="12">  
        <section class="quick-quote">
            <div class="wrap -size-md">
                <div id="quotes-normal-view">
                    <aura:if isTrue="{!v.normalView}" >
                        <div class="align-center _mg-b-sm">
                            <button class="button -secondary" id="show-quote-highlights" onclick="{!c.highlightView}">Compare</button>
                        </div>
                        <div class="grid -spacing-md">
                            <aura:if isTrue="{!v.showQualitas}">
                                <div class="grid_1-3 grid_1-lg">
                                    <div class="quote-box">
                                        <div class="quote-provider">
                                            <img src="{!$Resource.mexJs  + '/mexJs/images/qualitas.png'}" alt="Qualitas"/>
                                        </div>
                                        <div class="quote-pricing">
                                            <lightning:formattedNumber value="{!v.qualitasRateValue}" style="currency" currencyCode="USD" />
                                        </div>
                                        <div class="quote-body">
                                            <div class="unit">
                                                <h6 class="red" >Vehicle {!v.countVehicle}: {!v.quoteRecord.Vehicle_Type__c}</h6>
                                                <div class="grid -spacing-sm">
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input aura:Id="validateField" required="true" name="Start_Date_for_Coverage__c" type="date" variant="label-hidden" value="{!v.quoteRecord.Start_Date_for_Coverage__c}" onchange="{!c.fetchRateData}" min="{!v.minDate}"/>
                                                        </div>
                                                    </div>
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input aura:Id="validateField" required="true" name="End_Date_for_Coverage__c" type="date" variant="label-hidden" value="{!v.quoteRecord.End_Date_for_Coverage__c}" onchange="{!c.fetchRateData}" min="{!v.endMinDate}"/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="grid -spacing-sm">
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input type="time" name="Start_Time__c" label="START TIME" variant="label-hidden" placeholder="" value="{!v.quoteRecord.Start_Time__c}" disabled="true"/>
                                                        </div>
                                                    </div>
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input type="time" name="End_Time__c" label="End Time" variant="label-hidden" placeholder="" value="{!v.quoteRecord.End_Time__c}" disabled="true"/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="adjustable-fields">
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="{!v.daysTootip}"></i>
                                                            Days
                                                        </span>
                                                        <span class="field-item">
                                                            <lightning:input variant="label-hidden" type="number" class="full-width-field" disabled="true" value="{!v.days}" varient="label-hidden" />
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.additional_towunit}" >
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info" title="{!v.daysIntowTootip}"></i> 
                                                                    Days in tow
                                                            </span>
                                                            <span class="field-item">
                                                                <lightning:input variant="label-hidden" type="number" class="full-width-field" disabled="true" value="{!v.additional_towunit.Days_in_Tow__c}" varient="label-hidden" />
                                                            </span>
                                                        </div>
                                                    </aura:if>
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="Your estimate of vehicle value in case of a total loss.  This amount will be your limit for damages to, or total theft of your vehicle.  If you owe money on the vehicle you must list at least as much as you owe.  There is no gap coverage, but the lienholder will need to see their risk covered.  For guidance on value check Kelly Blue Book or NADA guides for Actual Cash Value or Private Party Value"></i>
                                                            Vehicle Value
                                                        </span>
                                                        <span class="field-item">
                                                            <lightning:input variant="label-hidden" type="number" class="full-width-field" formatter="currency" step="0.01" disabled="true" value="{!v.quoteRecord.Vehicle_Value__c}" varient="label-hidden" />
                                                        </span>
                                                    </div>
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="This amount goes toward damages to the other party (3rd party) that you are responsible for.  This includes property damage, medical expenses and death benefits combined. "></i> 
                                                            Combined Liability
                                                        </span>
                                                        <span class="field-item">
                                                            <button class="field-minus" name="qualitasLiability" data-type="low" onclick="{!c.updateLiability}" ></button>
                                                            <lightning:formattedNumber value="{!v.qualitasLiability}" style="currency" currencyCode="USD"/>
                                                            <button class="field-plus" name="qualitasLiability" data-type="high" onclick="{!c.updateLiability}"></button>
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.isMedicalPayment &amp;&amp; v.policyType != 'Motorcycle/Street Legal ATV'}">
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info" title="This is the amount of coverage for medical expenses as result of accident for you and your vehicle occupants.  The first number is maximum per person, the second value is total limit per event."></i> 
                                                                Medical
                                                            </span>
                                                            <span class="field-item">
                                                                <button class="field-minus" name="qualitasMedical" data-type="low" onclick="{!c.updateMedical}" ></button>
                                                                <input type="text" value="{!v.qualitasMedical}"/>
                                                                <button class="field-plus" name="qualitasMedical"  data-type="high" onclick="{!c.updateMedical}"></button>
                                                            </span>
                                                        </div>
                                                    </aura:if>	
                                                </div><!-- end adjustable-fields -->
                                                <div class="checkbox-field">
                                                    <lightning:input type="checkbox" name="qualitasLiablityOnly" label="Liability Only" checked="{!v.qualitasLiablityOnly}" onchange="{!c.updateLibilityValue}"/>
                                                </div>
                                            </div><!-- end unit -->
                                            
                                            <!--<aura:if isTrue="{v.policyType == 'Motorcycle/Street Legal ATV'}">
                                                <div class="unit">
                                                    <h6 class="red">Towed Unit 1: ATV</h6>
                                                    
                                                    <div class="adjustable-fields">
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info">How many days will the towed unit be attached to the towing vehicle?  You’ll only be charged the additional towing premium for those days in tow (as opposed to the entire term).  Keep in mind that with Qualitas and Mapfre, when a towed unit is detached from the towing vehicle, it no longer has coverage.  If you select Chubb, your towed trailer will have coverage even after it is detached if you match “days in tow” with the term.  If you are towing a travel trailer and select Chubb you should match the 'Days in Tow' with the Term of the Policy.  Example 365 day policy, days in tow = 365.</i> Days in tow
                                                            </span>
                                                            <span class="field-item">
                                                                <button class="field-minus"></button>
                                                                <input type="text" value="10" />
                                                                <button class="field-plus"></button>
                                                            </span>
                                                        </div>
                                                    </div> end adjustable-fields
                                                </div> 
                                            </aura:if>-->

                                            <div class="quote-button">
                                                <button class="button -secondary -wider" name="qualitasRate" onclick="{!c.onNextClick}" disabled="{!and(!v.qualitasLiablityOnly, !v.liabilityshowQualitas)}" style="{!if(and(!v.qualitasLiablityOnly, !v.liabilityshowQualitas), 'background: #e9eaec;', '')}">Purchase</button>
                                            </div>

                                            <div class="quote-terms">
                                                <aura:if isTrue="{!v.policyType == 'Automobile'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_Automobile_Qualitas}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'RV'}">
                                                    
                                                    <a href="{!$Label.c.Terms_and_Conditions_RV_Qualitas}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'Motorcycle/Street Legal ATV'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_Motorcycle_Qualitas}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <!--a href="#" class="simple-link" target="_blank">Full terms <i class="icon-new-tab"></i></a-->
                                            </div>
                                        </div>
                                    </div><!-- end quote-box -->
                                </div>
                            </aura:if>

                            <aura:if isTrue="{!v.showChubb}">
                                <div class="grid_1-3 grid_1-lg">
                                    <div class="quote-box -recommended">
                                        <div class="quote-provider">
                                            <img src="{!$Resource.mexJs  + '/mexJs/images/chubb.png'}" alt="Chubb" /> 
                                            <div class="recommended-label">Recommended</div>
                                        </div>
                                        <div class="quote-pricing">
                                            <lightning:formattedNumber value="{!v.chubbRateValue}" style="currency" currencyCode="USD"/>
                                        </div>
                                        <!--    chubb part     -->
                                        <div class="quote-body">
                                            <div class="unit">
                                                <h6 class="red">Vehicle {!v.countVehicle}: {!v.quoteRecord.Vehicle_Type__c}</h6>
                                                <div class="grid -spacing-sm">
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input aura:Id="validateField" required="true" name="Start_Date_for_Coverage__c" type="date" variant="label-hidden" value="{!v.quoteRecord.Start_Date_for_Coverage__c}" onchange="{!c.fetchRateData}" min="{!v.minDate}"/>
                                                        </div>
                                                    </div>
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input aura:Id="validateField" required="true" name="End_Date_for_Coverage__c" type="date" variant="label-hidden" value="{!v.quoteRecord.End_Date_for_Coverage__c}" onchange="{!c.fetchRateData}" min="{!v.endMinDate}"/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="grid -spacing-sm">
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input type="time" name="Start_Time__c" label="START TIME" variant="label-hidden" placeholder="" value="{!v.quoteRecord.Start_Time__c}" disabled="true"/>
                                                        </div>
                                                    </div>
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input type="time" name="End_Time__c" label="End Time" variant="label-hidden" placeholder="" value="{!v.quoteRecord.End_Time__c}" disabled="true"/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="adjustable-fields">
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="{!v.daysTootip}"></i> 
                                                            Days
                                                        </span>
                                                        <span class="field-item">
                                                            <lightning:input variant="label-hidden" type="number" class="full-width-field" disabled="true" value="{!v.days}" varient="label-hidden" />
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.additional_towunit}" >
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info" title="{!v.daysIntowTootip}"></i> 
                                                                    Days in tow
                                                            </span>
                                                            <span class="field-item">
                                                                <lightning:input variant="label-hidden" type="number" class="full-width-field" disabled="true" value="{!v.additional_towunit.Days_in_Tow__c}" varient="label-hidden" />
                                                            </span>
                                                        </div>
                                                    </aura:if>
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="Your estimate of vehicle value in case of a total loss.  This amount will be your limit for damages to, or total theft of your vehicle.  If you owe money on the vehicle you must list at least as much as you owe.  There is no gap coverage, but the lienholder will need to see their risk covered.  For guidance on value check Kelly Blue Book or NADA guides for Actual Cash Value or Private Party Value."></i>
                                                            Vehicle Value
                                                        </span>
                                                        <span class="field-item">
                                                            <lightning:input variant="label-hidden" type="number" class="full-width-field" formatter="currency" step="0.01" disabled="true" value="{!v.quoteRecord.Vehicle_Value__c}" varient="label-hidden" />
                                                        </span>
                                                    </div>
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="This amount goes toward damages to the other party (3rd party) that you are responsible for.  This includes property damage, medical expenses and death benefits combined. "></i> 
                                                            Combined Liability
                                                        </span>
                                                        <span class="field-item">
                                                            <button class="field-minus" name="chubbLiability" data-type="low" onclick="{!c.updateLiability}" ></button>
                                                            <!--input type="text" value="{!v.chubbLiability}"/ -->
                                                            <lightning:formattedNumber value="{!v.chubbLiability}" style="currency" currencyCode="USD"/>
                                                            <button class="field-plus" name="chubbLiability" data-type="high" onclick="{!c.updateLiability}"></button>
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.isMedicalPayment &amp;&amp; v.policyType != 'Motorcycle/Street Legal ATV'}">
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info" title="This is the amount of coverage for medical expenses as result of accident for you and your vehicle occupants.  The first number is maximum per person, the second value is total limit per event."></i> 
                                                                Medical
                                                            </span>
                                                            <span class="field-item">
                                                                <button class="field-minus" name="chubbMedical" data-type="low" onclick="{!c.updateMedical}" ></button>
                                                                <input type="text" value="{!v.chubbMedical}"/>
                                                                <button class="field-plus" name="chubbMedical"  data-type="high" onclick="{!c.updateMedical}"></button>
                                                            </span>
                                                        </div>
                                                    </aura:if>
                                                </div><!-- end adjustable-fields -->
                                                <div class="checkbox-field">
                                                    <lightning:input type="checkbox" name="chubbLiablityOnly" label="Liability Only" checked="{!v.chubbLiablityOnly}" onchange="{!c.updateLibilityValue}"/>
                                                </div>
                                            </div><!-- end unit -->
                                            
                                            <!--<aura:if isTrue="{!v.policyType != 'Motorcycle/Street Legal ATV'}">
                                                <div class="unit">
                                                    <h6 class="red">Towed Unit 1: ATV</h6>
                                                    
                                                    <div class="adjustable-fields">
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info"></i> Days in tow
                                                            </span>
                                                            <span class="field-item">
                                                                <button class="field-minus"></button>
                                                                <input type="text" value="10" />
                                                                <button class="field-plus"></button>
                                                            </span>
                                                        </div>
                                                    </div> end adjustable-fields
                                                </div>
                                            </aura:if>-->

                                            <div class="quote-button">
                                                <button class="button -ternary -wider" name="chubbRate" onclick="{!c.onNextClick}" disabled="{!and(!v.chubbLiablityOnly, !v.liabilityshowChubb)}" style="{!if(and(!v.chubbLiablityOnly, !v.liabilityshowChubb), 'background: #e9eaec;', '')}">Purchase</button>
                                            </div>

                                            <div class="quote-terms">
                                                <aura:if isTrue="{!v.policyType == 'Automobile'}">
                                                <a href="{!$Label.c.Terms_and_Conditions_Automobile_Chubb}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'RV'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_RV_Chubb}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'Motorcycle/Street Legal ATV'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_Motorcycle_Chubb}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <!--a href="#" class="simple-link" target="_blank">Full terms <i class="icon-new-tab"></i></a-->
                                            </div>
                                        </div>
                                    </div><!-- end quote-box -->
                                </div>
                            </aura:if>

                            <aura:if isTrue="{!v.showMapfre}">
                                <div class="grid_1-3 grid_1-lg">
                                    <div class="quote-box">
                                        <div class="quote-provider">
                                            <img src="{!$Resource.mexJs  + '/mexJs/images/mapfre-logo.png'}" alt="Mapfre"/>
                                            <!--img src="{!$Resource.mexJs  + '/mexJs/images/qualitas.png'}" alt="Qualitas"/-->
                                        </div>
                                        <div class="quote-pricing">
                                            <lightning:formattedNumber value="{!v.mapfreRateValue}" style="currency" currencyCode="USD"/>
                                        </div>
                                        
                                        <div class="quote-body">
                                            
                                            <div class="unit">
                                                <h6 class="red">Vehicle {!v.countVehicle}: {!v.quoteRecord.Vehicle_Type__c}</h6>
                                                <div class="grid -spacing-sm">
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input aura:Id="validateField" required="true"  name="Start_Date_for_Coverage__c" type="date" variant="label-hidden" value="{!v.quoteRecord.Start_Date_for_Coverage__c}" onchange="{!c.fetchRateData}" min="{!v.minDate}"/>
                                                        </div>
                                                    </div>
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input aura:Id="validateField" required="true" name="End_Date_for_Coverage__c" type="date" variant="label-hidden" value="{!v.quoteRecord.End_Date_for_Coverage__c}" onchange="{!c.fetchRateData}" min="{!v.endMinDate}"/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="grid -spacing-sm">
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input type="time" name="Start_Time__c" label="START TIME" variant="label-hidden" placeholder="" value="{!v.quoteRecord.Start_Time__c}" disabled="true"/>
                                                        </div>
                                                    </div>
                                                    <div class="grid_1-2">
                                                        <div class="datepicker">
                                                            <lightning:input type="time" name="End_Time__c" label="End Time" variant="label-hidden" placeholder="" value="{!v.quoteRecord.End_Time__c}" disabled="true"/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="adjustable-fields">
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="{!v.daysTootip}"></i> 
                                                            Days
                                                        </span>
                                                        <span class="field-item">
                                                            <lightning:input variant="label-hidden" type="number" class="full-width-field" disabled="true" value="{!v.days}" varient="label-hidden" />
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.additional_towunit}" >
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info" title="{!v.daysIntowTootip}"></i> 
                                                                    Days in tow
                                                            </span>
                                                            <span class="field-item">
                                                                <lightning:input variant="label-hidden" type="number" class="full-width-field" disabled="true" value="{!v.additional_towunit.Days_in_Tow__c}" varient="label-hidden" />
                                                            </span>
                                                        </div>
                                                    </aura:if>
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="Your estimate of vehicle value in case of a total loss.  This amount will be your limit for damages to, or total theft of your vehicle.  If you owe money on the vehicle you must list at least as much as you owe.  There is no gap coverage, but the lienholder will need to see their risk covered.  For guidance on value check Kelly Blue Book or NADA guides for Actual Cash Value or Private Party Value."></i>
                                                            Vehicle Value
                                                        </span>
                                                        <span class="field-item">
                                                            <lightning:input variant="label-hidden" type="number" class="full-width-field" formatter="currency" step="0.01" disabled="true" value="{!v.quoteRecord.Vehicle_Value__c}" varient="label-hidden" />
                                                        </span>
                                                    </div>
                                                    <div class="adjustable-field">
                                                        <span class="field-label">
                                                            <i class="icon-info" title="This amount goes toward damages to the other party (3rd party) that you are responsible for.  This includes property damage, medical expenses and death benefits combined. "></i>
                                                            Combined Liability
                                                        </span>
                                                        <span class="field-item">
                                                            <button class="field-minus" name="mapfreLiability" data-type="low" onclick="{!c.updateLiability}" ></button>
                                                            <!--<input type="text" value="{!v.mapfreLiability}"/ -->
                                                            <lightning:formattedNumber value="{!v.mapfreLiability}" style="currency" currencyCode="USD"/>
                                                            <button class="field-plus" name="mapfreLiability" data-type="high" onclick="{!c.updateLiability}"></button>
                                                        </span>
                                                    </div>
                                                    <aura:if isTrue="{!v.isMedicalPayment &amp;&amp; v.policyType != 'Motorcycle/Street Legal ATV'}">
                                                        
                                                            <div class="adjustable-field">
                                                                <span class="field-label">
                                                                    <i class="icon-info" title="This is the amount of coverage for medical expenses as result of accident for you and your vehicle occupants.  The first number is maximum per person, the second value is total limit per event."></i>
                                                                    Medical
                                                                </span>
                                                                <span class="field-item">
                                                                    <button class="field-minus" name="mapfreMedical" data-type="low" onclick="{!c.updateMedical}" ></button>
                                                                    <input type="text" value="{!v.mapfreMedical}"/>
                                                                    <button class="field-plus" name="mapfreMedical"  data-type="high" onclick="{!c.updateMedical}"></button>
                                                                    
                                                                </span>
                                                            </div>
                                                        
                                                    </aura:if>
                                                        
                                                </div><!-- end adjustable-fields -->
                                                <aura:if isTrue="{!v.policyType == 'Automobile'}">
                                                    <div class="checkbox-field">
                                                        <lightning:input type="radio" name="select" label="Liability Only" onchange="{!c.onGroup}" checked="{!v.mapfreLiablityOnly == 'Liability'}"/>
                                                        <lightning:input type="radio" name="select" label="Full Coverage"  onchange="{!c.onGroup}" checked="{!v.mapfreLiablityOnly == 'Complete'}"/>
                                                        <lightning:input type="radio" name="select" label="Max Coverage" onchange="{!c.onGroup}" checked="{!v.mapfreLiablityOnly == 'Max'}"/>
                                                    </div>
                                                    <aura:set attribute="else">
                                                        <div class="checkbox-field">
                                                            <lightning:input type="radio" name="select" label="Liability Only" onchange="{!c.onGroup}" checked="{!v.mapfreLiablityOnly == 'Liability'}"/>
                                                            <lightning:input type="radio" name="select" label="Liability + Theft"  onchange="{!c.onGroup}" checked="{!v.mapfreLiablityOnly == 'LiabilityTheft'}"/>
                                                            <lightning:input type="radio" name="select" label="Complete Coverage" onchange="{!c.onGroup}" checked="{!v.mapfreLiablityOnly == 'Complete'}"/>
                                                        </div>
                                                    </aura:set>
                                                </aura:if>
                                            </div><!-- end unit -->
                                            
                                            <!--<aura:if isTrue="{v.policyType == 'Motorcycle/Street Legal ATV'}">
                                                <div class="unit">
                                                    <h6 class="red">Towed Unit 1: ATV</h6>
                                                    
                                                    <div class="adjustable-fields">
                                                        <div class="adjustable-field">
                                                            <span class="field-label">
                                                                <i class="icon-info"></i> Days in tow
                                                            </span>
                                                            <span class="field-item">
                                                                <button class="field-minus"></button>
                                                                <input type="text" value="10" />
                                                                <button class="field-plus"></button>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </aura:if>-->

                                            <div class="quote-button">
                                                <button class="button -secondary -wider" name="mapfreRate" onclick="{!c.onNextClick}" disabled="{!and(v.mapfreLiablityOnly != 'Liability', !v.liabilityshowMapfre)}" style="{!if(and(v.mapfreLiablityOnly != 'Liability',  !v.liabilityshowMapfre), 'background: #e9eaec;', '')}">Purchase</button>
                                            </div>
                                            
                                            <div class="quote-terms">
                                                <aura:if isTrue="{!v.policyType == 'Automobile'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_Automobile_Mapfre}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'RV'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_RV_Mapfre}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'Motorcycle/Street Legal ATV'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_Motorcycle_Mapfre}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <!--a href="#" class="simple-link" target="_blank">Full terms <i class="icon-new-tab"></i></a-->
                                            </div>
                                            
                                            
                                        </div>
                                    </div><!-- end quote-box -->
                                </div>
                            </aura:if>
                        </div><!-- end grid -->
                    </aura:if>
                </div><!-- end #quotes-normal-view -->
                
                <aura:if isTrue="{!v.highlightView}">
                    <div class="quotes-highlights-view">
                        <div class="align-center _mg-b-sm">
                            <button class="button -secondary" id="show-normal-view" onclick="{!c.normalView}">Quote Detail</button>
                        </div>
                        
                        <div class="grid -spacing-md">
                            
                            <aura:if isTrue="{!v.showQualitas}">
                                <div class="grid_1-3 grid_1-lg">
                                    <div class="quote-box">
                                        <div class="quote-provider">
