                                                    </div>
                                                </div>
                                            </aura:if>

                                            <div class="quote-button slds-p-top_large">
                                                <button class="button -secondary -wider" name="qualitasRate" onclick="{!c.onNextClick}" disabled="{!and(!v.qualitasLiablityOnly, !v.liabilityshowQualitas)}" style="{!if(and(!v.qualitasLiablityOnly, !v.liabilityshowQualitas), 'background: #e9eaec;', '')}" >Purchase</button>
