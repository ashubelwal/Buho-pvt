                                                        <i class="icon-checkmark"></i>
                                                        <aura:set attribute="else">
                                                            <!--<i class="icon-cross"></i>-->
                                                            <i style="text-align=right;">{!v.coverageMap.Qualitas.Deductibles__c}</i>
                                                        </aura:set>
                                                    </aura:if>
