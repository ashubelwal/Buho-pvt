                                                                            $0
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </aura:if>
                                                </aura:if>
                                                
                                                <div class="highlight-list-desc">
                                                    <aura:if isTrue="{!!v.qualitasLiablityOnly}">
                                                        <div class="highlight-title" style="padding-left: 15px">
                                                            Collision Deductible
                                                            <aura:if isTrue="{!or(v.policyType == 'Automobile')}">
