                                                                        </aura:set>
                                                                    </aura:if>
                                                                </span>
                                                            </aura:if>
                                                            <aura:if isTrue="{!or(v.policyType == 'RV')}">
                                                                <span style="position: absolute;right: 0;">
                                                                    <aura:if isTrue="{!empty(v.rv_collision_deductible)}">
                                                                        N/A
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber value="{!v.rv_collision_deductible}" style="currency" currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </span>
                                                            </aura:if>
                                                            <aura:if isTrue="{!or(v.policyType == 'Motorcycle/Street Legal ATV')}">
                                                                <span style="position: absolute;right: 0;">
                                                                    <aura:if isTrue="{!empty(v.moto_qual_collision_deductible)}">
                                                                        N/A
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber value="{!v.moto_qual_collision_deductible}" style="currency" currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </span>
                                                            </aura:if>
                                                            <aura:if isTrue="{!and(v.policyType != 'Automobile', v.policyType != 'RV')}">
                                                                <aura:if isTrue="{!and(v.policyType != 'Motorcycle/Street Legal ATV' )}">
                                                                    <aura:if isTrue="{!empty(v.coverageMap.Qualitas.Collision_Deductible__c)}">
