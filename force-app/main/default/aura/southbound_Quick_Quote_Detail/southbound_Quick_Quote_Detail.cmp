                                                <div class="quote-highlight">
                                                    <div class="highlight-title">
                                                        
                                                        Plane Tickets Home
                                                        <aura:if isTrue="{!v.coverageMap.Qualitas.Plane_Tickets_Home__c == 'Yes'}">
