                                                        <i class="icon-checkmark"></i>
                                                        <aura:set attribute="else">
                                                            <i class="icon-cross"></i>
                                                        </aura:set>
                                                    </aura:if>
                                                </div>
                                                <aura:if isTrue="{!not(empty(v.coverageMap.Qualitas.Roadside_Details__c))}">
