                                                                        N/A
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber value="{!v.rv_theft_Total}" style="currency" currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </span>
                                                            </aura:if>
                                                            <aura:if isTrue="{!or(v.policyType == 'Motorcycle/Street Legal ATV')}">
                                                                <span style="position: absolute;right: 0;">
                                                                    <aura:if isTrue="{!empty(v.moto_qual_theft_Total)}">
                                                                        N/A
                                                                        <aura:set attribute="else">
                                                                            <lightning:formattedNumber value="{!v.moto_qual_theft_Total}" style="currency" currencyCode="USD" />
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </span>
                                                            </aura:if>
                                                            <aura:if isTrue="{!and(v.policyType != 'Automobile', v.policyType != 'RV')}">
                                                                <aura:if isTrue="{!and(v.policyType != 'Motorcycle/Street Legal ATV')}">
                                                                    <aura:if isTrue="{!empty(v.coverageMap.Qualitas.Total_Theft_Deductible__c)}">
                                                                        <span style="position: absolute;right: 0;">N/A</span>
                                                                        <aura:set attribute="else">
                                                                            <div class="slds-text-align_right">
                                                                                <lightning:formattedNumber value="{!v.coverageMap.Qualitas.Total_Theft_Deductible__c}" style="currency" currencyCode="USD" />
                                                                            </div>
                                                                        </aura:set>
                                                                    </aura:if>
                                                                </aura:if>
                                                            </aura:if>
                                                        </div>
                                                    </aura:if>
                                                    <div class="highlight-title" style="padding-left: 15px">
                                                        Uninsured/Underinsured Motorist Deductible Waiver
                                                        <aura:if isTrue="{!v.coverageMap.Qualitas.Uninsured_Motorist_Deductible_Waiver__c == 'Yes'}">
                                                            <i class="icon-checkmark"></i>
                                                            <aura:set attribute="else">
                                                                <!--<i class="icon-cross"></i> -->
                                                                <i style="text-align=right;">{!v.coverageMap.Qualitas.Uninsured_Motorist_Deductible_Waiver__c}</i>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <aura:if isTrue="{!!v.qualitasLiablityOnly}">
                                                <div class="quote-highlight">
                                                    <div class="highlight-title">
                                                        Labor Rates
                                                        <aura:if isTrue="{!empty(v.coverageMap.Qualitas.Labor_Rates__c)}">
                                                            <span style="position: absolute;right: 0;">N/A</span>
                                                            <aura:set attribute="else">
                                                                <div class="slds-text-align_right">
                                                                    {!v.coverageMap.Qualitas.Labor_Rates__c}
                                                                </div>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                
                                                <div class="quote-highlight">
                                                    <div class="highlight-title">
                                                        Glass Breakage
                                                        <aura:if isTrue="{!v.coverageMap.Qualitas.Glass_Breakage__c == 'Yes'}">
