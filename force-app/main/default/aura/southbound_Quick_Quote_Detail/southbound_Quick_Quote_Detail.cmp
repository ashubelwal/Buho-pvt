                                                    <div class="highlight-title">
                                                        Plane Tickets Home
                                                        <aura:if isTrue="{!v.coverageMap.Mapfre.Plane_Tickets_Home__c == 'Yes'}">
                                                            <i class="icon-checkmark"></i>
                                                            <aura:set attribute="else">
                                                                <i class="icon-cross"></i>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                                
                                                <div class="quote-highlight">
                                                    <div class="highlight-title">
                                                        Bonus Coverage
                                                        <aura:if isTrue="{!empty(v.coverageMap.Mapfre.Bonus_Coverage__c)}">
                                                            <span style="position: absolute;right: 0;">N/A</span>
                                                            <aura:set attribute="else">
                                                                <div class="slds-text-align_right">
                                                                    {!v.coverageMap.Mapfre.Bonus_Coverage__c}
                                                                </div>
                                                            </aura:set>
                                                        </aura:if>
                                                    </div>
                                                </div>
                                            </aura:if>

                                            <div class="quote-button slds-p-top_large">
                                                <button class="button -secondary -wider" name="mapfreRate" onclick="{!c.onNextClick}" disabled="{!and(v.mapfreLiablityOnly != 'Liability', !v.liabilityshowMapfre)}" style="{!if(and(v.mapfreLiablityOnly != 'Liability', !v.liabilityshowMapfre), 'background: #e9eaec;', '')}"> Purchase</button>
                                            </div>

                                            <div class="quote-terms">
                                                <aura:if isTrue="{!v.policyType == 'Automobile'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_Automobile_Mapfre}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'RV'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_RV_Mapfre}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <aura:if isTrue="{!v.policyType == 'Motorcycle/Street Legal ATV'}">
                                                    <a href="{!$Label.c.Terms_and_Conditions_Motorcycle_Mapfre}" class="simple-link"
                                                    target="_blank">Full terms <i class="icon-new-tab"></i></a>
                                                </aura:if>
                                                <!--a href="#" class="simple-link" target="_blank">Full terms <i class="icon-new-tab"></i></a-->
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </aura:if>
                            
                        </div><!-- end grid -->
                        
                    </div><!-- end #quotes-highlights-view -->
                </aura:if>
                
                
                <div class="align-center _mg-b-md">
                    <aura:if isTrue="{!!v.additional_towunit}">
                        <a href="javascript:void(0)" class="simple-link" onclick="{!c.openModel}">Save quotes</a>
                        <aura:set attribute="else">
                            <a href="javascript:void(0)" class="simple-link" onclick="{!v.onNextClick}" >NO, THANKS I'M FINE</a>
                        </aura:set>
                    </aura:if>
                </div>
            </div>
            
        </section>
        
        <aura:if isTrue="{!v.saveQuotePop}">
            <!-- Modal/Popup Box starts here-->
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                <div class="slds-modal__container">
                    <!-- Modal/Popup Box Header Starts here-->
                    <header class="slds-modal__header">
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{! c.closeModel }"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">Save Quote</h2>
                    </header>
                    <!--Modal/Popup Box Body Starts here-->
                    <div class="slds-modal__content slds-p-around_medium" id="modal-content-id-1">
                        <div class="slds-size_12-of-12">
                            <div class="form-container">
                                <lightning:input aura:Id="validateField" type="text" name="firstName" placeholder="First Name" value="{!v.leadRecord.Firstname}" variant="label-hidden" required="true" />
                                <lightning:input aura:Id="validateField" type="text" name="lastName" placeholder="Last Name" value="{!v.leadRecord.Lastname}" required="true" variant="label-hidden" class="slds-m-top_small"/>
                                <lightning:input aura:Id="validateField" type="Email" name="Email"
                                                 placeholder="Email" value="{!v.leadRecord.Email}" required="true"
                                                 variant="label-hidden" class="slds-m-top_small"/>
                                <lightning:input aura:Id="validateField" type="tel" name="phone"
                                                 placeholder="Phone" value="{!v.leadRecord.Phone}"
                                                 onchange="{!c.updatePhoneValue}"
                                                 pattern="^\(\d{3}\)\s\d{3}-\d{4}$"
                                                 messageWhenPatternMismatch="Not a valid phone number"
                                                 variant="label-hidden" class="slds-m-top_small"/>
                            </div>
                        </div>
                    </div>
                    <!--Modal/Popup Box Footer Starts here-->
                    <footer class="slds-modal__footer">
                        <lightning:button variant="neutral" label="Cancel" title="Cancel"
                                          onclick="{! c.closeModel }"/>
                        <lightning:button variant="brand" label="Save Quote" title="Save Quote"
                                          onclick="{!c.saveQuote}"/>
                    </footer>
                </div>
            </section>
            <div class="slds-backdrop slds-backdrop_open"></div>
        </aura:if>

    </lightning:layoutItem>
</aura:component>