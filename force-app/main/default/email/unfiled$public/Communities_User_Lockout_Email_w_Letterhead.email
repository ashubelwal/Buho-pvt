<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Hello&nbsp;</span></font><font face="arial"><span style="font-size: 12pt;">{!Receiving_User.Username},</span></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style=""><font face="arial"><span style="font-size: 12pt;">We received your request to reset your {!Community.Name} password. We can't reset your password right now. Your account is locked after too many login attempts.</span></font><br><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">If you didn't request a password reset or haven't tried to log in to your account recently, contact your {!Community.Name} administrator or reply to this email.</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Thank you,</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Community.Name}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div></div></div></div></div>]]></td>
</tr>
</table>