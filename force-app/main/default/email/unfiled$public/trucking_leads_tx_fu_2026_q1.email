<!doctype html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="x-apple-disable-message-reformatting">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>BUHO Insurance Follow-Up</title>

    <!--[if mso]>
      <xml>
        <o:OfficeDocumentSettings>
          <o:AllowPNG/>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    <![endif]-->

    <style>
      /* CLIENT-SPECIFIC RESETS */
      html, body { margin:0 !important; padding:0 !important; height:100% !important; width:100% !important; }
      * { -ms-text-size-adjust:100%; -webkit-text-size-adjust:100%; }
      table, td { mso-table-lspace:0pt !important; mso-table-rspace:0pt !important; border-collapse:collapse !important; border-spacing:0 !important; }
      img { -ms-interpolation-mode:bicubic; border:0; outline:none; text-decoration:none; display:block; }
      a { text-decoration:none; }
      /* iOS blue links */
      a[x-apple-data-detectors], .unstyle-auto-detected-links a, .aBn {
        border-bottom:0 !important;
        cursor:default !important;
        color:inherit !important;
        text-decoration:none !important;
        font-size:inherit !important;
        font-family:inherit !important;
        font-weight:inherit !important;
        line-height:inherit !important;
      }
      /* Gmail fixes */
      u + #body a { color:inherit; text-decoration:none; font-size:inherit; font-family:inherit; font-weight:inherit; line-height:inherit; }

      /* MOBILE */
      @media screen and (max-width: 620px) {
        .container { width:100% !important; }
        .px { padding-left:18px !important; padding-right:18px !important; }
        .py { padding-top:18px !important; padding-bottom:18px !important; }
        .logo { width:240px !important; height:auto !important; }
        .h1 { font-size:22px !important; line-height:28px !important; }
        .p { font-size:16px !important; line-height:24px !important; }
      }
    </style>
  </head>

  <body id="body" style="margin:0; padding:0; background-color:#ededed;">
    <!-- Preheader (hidden) -->
    <div style="display:none; font-size:1px; line-height:1px; max-height:0px; max-width:0px; opacity:0; overflow:hidden; mso-hide:all;">
      We’ve expanded our trucking insurance markets with new carrier options and flexible payments.
    </div>

    <center role="article" aria-roledescription="email" lang="en" style="width:100%; background-color:#ededed;">
      <!--[if mso]>
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
        <tr>
          <td align="center" style="background-color:#ededed;">
      <![endif]-->

      <!-- Outer container -->
      <table role="presentation" class="container" cellspacing="0" cellpadding="0" border="0" align="center" width="600" style="width:600px; margin:0 auto;">
        <tr>
          <td style="padding:18px 10px;">
            <!-- Card -->
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color:#ffffff; border-radius:10px; overflow:hidden;">
              <!-- Header / Logo -->
              <tr>
                <td align="center" style="padding:22px 18px 10px 18px; background-color:#ffffff;">
                  <img
                    src="https://gobuho.com/wp-content/uploads/2026/01/Owl-Logo-Small.png"
                    width="320"
                    alt="BÚHO Insurance"
                    class="logo"
                    style="width:320px; max-width:100%; height:auto;">
                </td>
              </tr>

              <!-- Divider -->
              <tr>
                <td style="padding:0 30px;">
                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                      <td style="border-top:1px solid #e6e6e6; font-size:0; line-height:0;">&nbsp;</td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Body -->
              <tr>
                <td class="px py" style="padding:24px 30px 18px 30px; font-family:Arial, Helvetica, sans-serif; color:#5e5e5e;">
                  <h1 class="h1" style="margin:0 0 14px 0; font-size:24px; line-height:30px; font-weight:700; color:#003a70;">
                    Quick follow-up from the Texas Trucking Show
                  </h1>

                  <p class="p" style="margin:0 0 14px 0; font-size:18px; line-height:26px;">
                    Hello {!Lead.FirstName},
                  </p>

                  <p class="p" style="margin:0 0 14px 0; font-size:18px; line-height:26px;">
                    It was great connecting with you at the Texas Trucking Show.
                  </p>

                  <p class="p" style="margin:0 0 14px 0; font-size:18px; line-height:26px;">
                    I wanted to follow up because we’ve expanded our trucking insurance markets and added new carrier options that work well for owner-operators and fleets. In addition, we now offer flexible payment and financing options, which can significantly reduce the upfront cost for higher-premium policies.
                  </p>

                  <p class="p" style="margin:0 0 18px 0; font-size:18px; line-height:26px;">
                    BUHO Insurance works with multiple trucking carriers, allowing us to structure coverage and payments that better fit your operation and cash flow.
                  </p>

                  <p class="p" style="margin:0 0 18px 0; font-size:18px; line-height:26px;">
                    I’ll be reaching out shortly to review options and next steps. If you prefer, feel free to reply with a good time to connect.
                  </p>

                  <p class="p" style="margin:0; font-size:18px; line-height:26px;">
                    Best regards,<br>
                    {!User.Name}<br><br>
                    BUHO Insurance
                  </p>
                </td>
              </tr>

              <!-- Footer -->
              <tr>
                <td style="padding:16px 30px 22px 30px; background-color:#f3f4f6; font-family:Arial, Helvetica, sans-serif; color:#111827;">
                  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                      <td align="center" style="padding:0 0 10px 0;">
                        <img
                          src="https://gobuho.com/wp-content/uploads/2026/01/Owl-Logo-Small.png"
                          width="160"
                          alt="BÚHO Insurance"
                          style="width:160px; max-width:100%; height:auto;">
                      </td>
                    </tr>
                    <tr>
                      <td align="center" style="font-size:13px; line-height:18px; color:#111827;">
                        &copy; BÚHO Insurance
                      </td>
                    </tr>
                    <tr>
                      <td align="center" style="font-size:13px; line-height:18px; color:#111827; padding-top:4px;">
                        Texas Insurance License: 2485907
                      </td>
                    </tr>
                    <tr>
                      <td align="center" style="font-size:12px; line-height:17px; color:#111827; padding-top:6px;">
                        <a href="https://gobuho.com/" target="_blank" style="color:#111827; text-decoration:underline;">GoBuHo.com</a>
                        &nbsp;&nbsp;|&nbsp;&nbsp;
                        tel:+1.915.292.2992
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

            </table>
            <!-- /Card -->
          </td>
        </tr>
      </table>
      <!-- /Outer container -->

      <!--[if mso]>
          </td>
        </tr>
      </table>
      <![endif]-->
    </center>
  </body>
</html>