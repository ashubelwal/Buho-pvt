<table border="0" cellpadding="5" width="550" cellspacing="5" height="400" >
<tr valign="top" height="400" >
<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<font face="arial"><span style="font-size: 12pt;">Hi {!Receiving_User.FirstName},</span></font><div><font face="arial"><br></font></div><div><font face="arial">We received a request to change the email address for the username {!User.Username}. Please make sure the following changes are correct:</font></div><div><font face="arial"><br></font></div><div><font face="arial">Previous Email Address: {!ChgEmailVer.OldEmail}</font></div><div><font face="arial">New Email Address: {!ChgEmailVer.NewEmail}</font></div><div><font face="arial"><br></font></div><div><font face="arial">To finish changing your email address go to the following link. This link expires in 72 hours.</font></div><div><font face="arial"><br></font></div><div><font face="arial">{!ChgEmailVer.URL}</font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;"><br></span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt;">Thank you,</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Organization.Name}</div></div>]]></td>
</tr>
</table>